@page
@model PcStock_Web.Pages.Consommations.IndexModel
@{
    ViewData["Title"] = "Tableau de Bord";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="dashboard-wrapper">
    <!-- 1. الترحيب وشريط الوقت -->
    <div class="welcome-banner d-flex justify-content-between align-items-center shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">Bienvenue, ADMIN !</h2>
            <p class="mb-0 opacity-75">Heureux de vous revoir sur PcStock-Web.</p>
        </div>
        <div class="date-time-box text-end">
            <div class="date" id="currentDate">09/03/2026</div>
            <div class="time" id="currentTime">22:15:40</div>
        </div>
    </div>

    <!-- 2. بطاقات الإحصائيات (Stat Cards) -->
    <div class="row g-3 mt-1">
        <div class="col-md-2">
            <div class="stat-card bg-purple">
                <div class="icon"><i class="fas fa-truck-loading"></i></div>
                <div class="value">14</div>
                <div class="label">Fournisseurs</div>
                <a href="#" class="more-link">Voir plus <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card bg-orange">
                <div class="icon"><i class="fas fa-users"></i></div>
                <div class="value">85</div>
                <div class="label">Clients</div>
                <a href="#" class="more-link">Voir plus <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card bg-teal">
                <div class="icon"><i class="fas fa-file-invoice"></i></div>
                <div class="value">1 240</div>
                <div class="label">Bons de Réception (BEM)</div>
                <a href="#" class="more-link">Voir plus <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card bg-pink">
                <div class="icon"><i class="fas fa-user-tie"></i></div>
                <div class="value">12</div>
                <div class="label">Employés</div>
                <a href="#" class="more-link">Voir plus <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card bg-green">
                <div class="icon"><i class="fas fa-pills"></i></div>
                <div class="value">21 360</div>
                <div class="label">Articles en Stock</div>
                <a href="#" class="more-link">Voir plus <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- 3. الرسوم البيانية (Charts Section) -->
    <div class="row g-3 mt-2">
        <!-- الرسم البياني للفواتير -->
        <div class="col-md-4">
            <div class="chart-container shadow-sm">
                <h6 class="chart-title">Factures par Fournisseur</h6>
                <canvas id="invoiceChart"></canvas>
            </div>
        </div>
        <!-- الرسم البياني الدائري للمبالغ -->
        <div class="col-md-4">
            <div class="chart-container shadow-sm text-center">
                <h6 class="chart-title">Répartition des Montants</h6>
                <canvas id="pieChart"></canvas>
            </div>
        </div>
        <!-- إجمالي المبيعات/المشتريات الشهري -->
        <div class="col-md-4">
            <div class="chart-container shadow-sm">
                <h6 class="chart-title">Evolution Mensuelle (HT)</h6>
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 4. الجزء السفلي (الحضور والغياب) -->
    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="chart-container shadow-sm">
                <h6 class="chart-title text-center">Taux de Présence Général</h6>
                <div class="d-flex justify-content-center">
                    <div style="width: 200px;">
                        <canvas id="gaugeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="chart-container shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="chart-title mb-0">Top 5 Employés Absents</h6>
                    <select class="form-select form-select-sm" style="width: 150px;">
                        <option>Derniers 30 jours</option>
                    </select>
                </div>
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Nom & Prénom</th>
                            <th>Service</th>
                            <th>Nombre d'Absences</th>
                            <th>Taux</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Ahmed Moussaoui</td><td>Maintenance</td><td>4 Jours</td><td><div class="progress" style="height: 5px;"><div class="progress-bar bg-danger" style="width: 80%"></div></div></td></tr>
                        <tr><td>Said Benmoussa</td><td>Logistique</td><td>2 Jours</td><td><div class="progress" style="height: 5px;"><div class="progress-bar bg-warning" style="width: 40%"></div></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-wrapper {
        padding: 10px;
        background-color: #f1f5f9;
    }

    /* Banner */
    .welcome-banner {
        background: linear-gradient(135deg, #1e40af, #3b82f6);
        color: white;
        padding: 25px 35px;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .date-time-box {
        font-family: 'Consolas', monospace;
    }

        .date-time-box .date {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .date-time-box .time {
            font-size: 1rem;
            color: #dbeafe;
        }

    /* Stat Cards */
    .stat-card {
        padding: 20px;
        border-radius: 12px;
        color: white;
        position: relative;
        overflow: hidden;
        min-height: 140px;
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card .icon {
            font-size: 2.5rem;
            opacity: 0.2;
            position: absolute;
            right: 15px;
            top: 15px;
        }

        .stat-card .value {
            font-size: 1.8rem;
            font-weight: 800;
        }

        .stat-card .label {
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 10px;
            opacity: 0.9;
        }

        .stat-card .more-link {
            font-size: 0.75rem;
            color: white;
            text-decoration: none;
            border-top: 1px solid rgba(255,255,255,0.2);
            display: block;
            padding-top: 5px;
        }

    /* Colors */
    .bg-purple {
        background-color: #6366f1;
    }

    .bg-orange {
        background-color: #f59e0b;
    }

    .bg-teal {
        background-color: #0d9488;
    }

    .bg-pink {
        background-color: #db2777;
    }

    .bg-green {
        background-color: #10b981;
    }

    /* Chart Containers */
    .chart-container {
        background: white;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        height: 100%;
    }

    .chart-title {
        font-weight: 800;
        color: #475569;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // 1. تحديث الوقت واليوم تلقائياً
            setInterval(() => {
                const now = new Date();
                $('#currentTime').text(now.toLocaleTimeString());
            }, 1000);

            // 2. الرسم البياني للأعمدة (Invoices)
            new Chart(document.getElementById('invoiceChart'), {
                type: 'bar',
                data: {
                    labels: ['Mourad', 'Said', 'Houcine'],
                    datasets: [{
                        label: 'Nombre de factures',
                        data: [4, 1, 2],
                        backgroundColor: ['#3b82f6', '#ef4444', '#10b981']
                    }]
                }
            });

            // 3. الرسم البياني الدائري (Distribution)
            new Chart(document.getElementById('pieChart'), {
                type: 'doughnut',
                data: {
                    labels: ['S/PLiebher', 'Naftal', 'King Pneus'],
                    datasets: [{
                        data: [400, 300, 300],
                        backgroundColor: ['#0d9488', '#f59e0b', '#6366f1']
                    }]
                }
            });

            // 4. رسم بياني للتطور (Monthly Evolution)
            new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Fév', 'Mar'],
                    datasets: [{
                        label: 'Ventes Mensuelles',
                        data: [616000, 450000, 800000],
                        backgroundColor: '#60a5fa'
                    }]
                }
            });
        });
    </script>
}
