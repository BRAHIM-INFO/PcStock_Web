@page
@model PcStock_Web.Pages.Consommations.SYNTHESE_CONSOMModel
@{
    ViewData["Title"] = "Synthèse Dynamique";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">

<style>
    .report-container {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .header-info {
        font-size: 11px;
        font-weight: bold;
        line-height: 1.4;
    }

   /*  #mainTable {
        border: 1px solid #000 !important;
        font-size: 11px;
    } */

      /*   #mainTable thead th {
            border: 1px solid #000 !important;
            text-align: center;
            background-color: #f8f9fa;
            padding: 5px;
        } */

       /*  #mainTable tbody td {
            border: 1px solid #dee2e6 !important;
            padding: 4px 8px;
        } */

    /* .text-amount {
        text-align: right;
        font-family: 'Consolas', monospace;
        font-weight: bold;
    } */

    .bg-total-row {
        background-color: #f1f5f9;
    }

    .report-container {
        background: #f8fafc;
        padding: 20px;
        border-radius: 15px;
    }

    /* تصميم البطاقة الحاضنة للجدول */
    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 10px;
        border: 1px solid #e2e8f0;
    }

    /* تنسيق الجدول الاحترافي */
    #mainTable {
        border-collapse: separate !important;
        border-spacing: 0;
        width: 100% !important;
        border: none !important;
    }

        #mainTable thead th {
            background-color: #1e40af !important; /* أزرق كوزيدار */
            color: white !important;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 0.5px solid rgba(255,255,255,0.1) !important;
            padding: 8px 4px;
            text-align: center;
            vertical-align: middle;
        }

        /* تمييز صف "MONTANT" الفرعي */
        #mainTable thead tr:nth-child(2) th {
            background-color: #3b82f6 !important; /* أزرق أفتح قليلاً */
            font-size: 9px;
        }

        #mainTable tbody td {
            font-size: 12px;
            padding: 6px 12px;
            border: 0.5px solid #f1f5f9 !important;
            vertical-align: middle;
        }

    /* تنسيق الأرقام */
    .text-amount {
        text-align: right;
        font-family: 'JetBrains Mono', 'Consolas', monospace;
        font-weight: 600;
        color: #334155;
    }

    /* تمييز عمود التوتال الجانبي */
    .bg-total-column {
        background-color: #f8fafc !important;
        font-weight: 800 !important;
        color: #1e40af !important;
    }

    /* تنسيق الفوتر (المجاميع النهائية) */
    #tableFoot td {
        background-color: #1e293b !important;
        color: #f8fafc !important;
        font-weight: bold;
        padding: 10px;
        border: none !important;
    }

    .footer-total-final {
        color: #22c55e !important;
        font-size: 14px;
    }

    /* أزرار Toolbar */
    .btn-action {
        border-radius: 8px;
        font-weight: 700;
        padding: 8px 20px;
        font-size: 13px;
    }
</style>

<div class="container-fluid p-4">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
        <div class="d-flex align-items-center">
            <div class="bg-primary p-2 rounded-3 me-3 text-white">
                <i class="fas fa-chart-line fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">SYNTHÈSE DES CONSOMMATIONS</h4>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 10px;">Récapitulatif par Famille d'Article</small>
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <div class="input-group input-group-sm border rounded-3 p-1 bg-light">
                <span class="input-group-text border-0 bg-transparent fw-bold small">DU:</span>
                <input type="date" id="date1" class="form-control border-0 bg-transparent" value="@DateTime.Now.ToString("yyyy-MM-01")">
                <span class="input-group-text border-0 bg-transparent fw-bold small">AU:</span>
                <input type="date" id="date2" class="form-control border-0 bg-transparent" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                <button id="btnRefresh" class="btn btn-primary rounded-2 ms-2 px-3">Générer</button>
            </div>

            <button id="btnExcel" class="btn btn-success btn-action ms-2"><i class="fas fa-file-excel me-2"></i>Excel</button>
            <button class="btn btn-light border btn-action text-primary" onclick="window.print()"><i class="fas fa-print me-2"></i>Imprimer</button>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <table id="mainTable" class="table table-bordered">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
            <tfoot id="tableFoot"></tfoot>
        </table>
    </div>
</div> 

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        let dataTableInstance = null;

        // const format = (v) => v > 0 ? parseFloat(v).toLocaleString('en-US', {minimumFractionDigits: 2}) : '-';

         // دالة التنسيق المالي (تحويل 0 إلى شرطة - لجمالية التقرير مثل الإكسل)
            const format = (v) => {
                if (!v || v == 0) return '<span class="opacity-25">-</span>';
                return parseFloat(v).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            
            };
                function loadData() {
            const d1 = $('#date1').val();
            const d2 = $('#date2').val();

            // إظهار مؤشر تحميل
            Swal.showLoading();

            $.get(`?handler=LoadData&d1=${d1}&d2=${d2}`, function (response) {
                Swal.close();

                if (dataTableInstance) {
                    dataTableInstance.destroy();
                    $('#tableHead, #tableBody, #tableFoot').empty();
                }

                const families = response.families;
                const data = response.data;

                // 1. بناء الهيدر المزدوج
                let headHtml = `
                    <tr>
                        <th rowspan="2" style="width: 40px">ORD</th>
                        <th rowspan="2" style="width: 80px">N°BSM</th>
                        <th rowspan="2" style="width: 100px">DATE</th>`;

                families.forEach(f => {
                    headHtml += `<th>${f}</th>`;
                });

                headHtml += `<th rowspan="2" class="bg-total-column" style="width: 120px">TOTAL BSM</th></tr><tr>`;

                families.forEach(f => {
                    headHtml += `<th>MONTANT</th>`;
                });
                headHtml += `</tr>`;
                $('#tableHead').html(headHtml);

                // 2. بناء الأسطر
                let bodyHtml = '';
                let colTotals = Array(families.length).fill(0);
                let grandTotalAll = 0;

                data.forEach((row, idx) => {
                    bodyHtml += `
                        <tr>
                            <td class="text-center text-muted">${idx + 1}</td>
                            <td class="fw-bold text-dark">${row.no_bsm}</td>
                            <td class="text-center">${new Date(row.date).toLocaleDateString('fr-FR')}</td>`;

                    families.forEach((f, fIdx) => {
                        let val = row.amounts[f] || 0;
                        colTotals[fIdx] += val;
                        bodyHtml += `<td class="text-amount">${format(val)}</td>`;
                    });

                    bodyHtml += `<td class="text-amount bg-total-column">${format(row.total)}</td></tr>`;
                    grandTotalAll += row.total;
                });
                $('#tableBody').html(bodyHtml);

                // 3. بناء الفوتر (المجاميع النهائية)
                let footHtml = `
                    <tr>
                        <td colspan="3" class="text-center">TOTAL GÉNÉRAL HT</td>`;

                colTotals.forEach(t => {
                    footHtml += `<td class="text-amount">${format(t)}</td>`;
                });

                footHtml += `<td class="text-amount footer-total-final">${format(grandTotalAll)}</td></tr>`;
                $('#tableFoot').html(footHtml);

                // 4. تهيئة DataTable
                        // 4. تهيئة DataTable مع إصلاح الهيدر في الإكسل
                dataTableInstance = $('#mainTable').DataTable({
                   paging: false,
                   info: false,
                   searching: false,
                   scrollX: true,
                   scrollY: "500px",
                   scrollCollapse: true,
                   dom: 'Brt',
                   buttons: [{
                       extend: 'excelHtml5',
                       footer: true,
                       title: 'Synthèse_Consommations_Cosider',
                       messageTop: 'Période du ' + d1 + ' au ' + d2,
                       exportOptions: {
                           columns: ':visible',
                           format: {
                               // --- هذه الدالة هي التي ستصلح الهيدر في الإكسل ---
                               header: function (data, columnIdx) {
                                   // الأعمدة 0 و 1 و 2 هي (ORD, BSM, DATE) اتركها كما هي
                                   if (columnIdx >= 3 && columnIdx < (3 + families.length)) {
                                       // ارجع رقم العائلة من المصفوفة بدلاً من كلمة "MONTANT"
                                       return "Famille: " + families[columnIdx - 3];
                                   }
                                   // العمود الأخير هو TOTAL BSM
                                   if (columnIdx === (3 + families.length)) {
                                       return "TOTAL BSM";
                                   }
                                   return data;
                               } 
                           }
                       }
                   }]
                }); 
            });
        }

        $(document).ready(function () {
            loadData();
            $('#btnRefresh').click(loadData);
            $('#btnExcel').click(() => dataTableInstance.button('.buttons-excel').trigger());
        });
    </script> 
}