                <input type="number" id="itemQte" class="form-control text-center fw-bold" step="0.01" placeholder="0.00">
                <!-- السطر الجديد المضاف بالأسفل -->
                <div class="mt-1" style="font-size: 10px;">
                    <span class="text-white-50">Qte En Stock = </span>
                    <span id="displayStock" class="text-warning fw-bold">0.00</span>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label-custom text-white-50">P.A.M.P (DA)</label>
                <input type="text" id="itemPamp" class="form-control text-end border-0" readonly tabindex="-1">
            </div>
            <div class="col-md-1">
                <label class="form-label-custom text-white-50">Total HT</label>
                <input type="text" id="itemMontant" class="form-control text-end border-0 text-info" readonly tabindex="-1">
            </div>
            <div class="col-md-1">
                <button type="button" id="btnAddRow" class="btn-add"><i class="fas fa-plus"></i></button>
