@page
@model PcStock_Web.Pages.Cessions.Fournie.ValeurisationModel
@{
    ViewData["Title"] = "Valeurisation BSM";
}

<!-- المكتبات اللازمة -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .val-container { background: #f1f5f9; min-vh-100; padding: 20px; font-family: 'Segoe UI', sans-serif; }

    /* الهيدر العلوي */
    .header-card { background: white; border-radius: 15px; padding: 20px; margin-bottom: 15px; border: 1px solid #e2e8f0; }
    .form-label-custom { font-size: 11px; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 5px; display: block; }

    /* شريط اختيار المنتج (مثل الصورة) */
 /*    .entry-bar {
        background: #1e293b; /* لون داكن احترافي */
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        color: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    } */
    .entry-bar input, .entry-bar .select2-selection {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.2) !important;
        color: white !important;
        font-weight: bold;
    }
    .entry-bar .form-control:focus { background: rgba(255,255,255,0.1); border-color: #3b82f6; color: white; }

    /* الجدول */
    .table-card { background: white; border-radius: 15px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); overflow: hidden; }
    .table thead th { background: #f8fafc; color: #64748b; font-size: 12px; text-transform: uppercase; padding: 15px; border-bottom: 2px solid #f1f5f9; }
    .table tbody td { padding: 15px; vertical-align: middle; border-bottom: 1px solid #f1f5f9; font-weight: 600; }

    /* زر الإضافة */
    .btn-add { background: #2563eb; color: white; width: 100%; height: 45px; border-radius: 10px; font-size: 24px; display: flex; align-items: center; justify-content: center; transition: 0.2s; border: none; }
    .btn-add:hover { background: #1d4ed8; transform: scale(1.02); }

    /* الإجمالي الرقمي */
    .lcd-total {
        background: #000; color: #00ff41; font-family: 'Digital-7 Mono', sans-serif;
        font-size: 45px; padding: 5px 20px; border-radius: 8px; border: 3px solid #334155;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.5); min-width: 250px; text-align: right;
    }


    /* شريط الإدخال المطور (بخطوط كبيرة وتصميم عصري) */
    .entry-bar {
        background: #1e293b;
        padding: 25px;
        border-radius: 18px;
        margin-bottom: 25px;
        color: white;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }

    /* تكبير العناوين فوق الحقول */
    .label-xl {
        font-size: 13px;
        font-weight: 850;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 10px;
        display: block;
        letter-spacing: 0.5px;
    }

    /* تنسيق الحقول الضخمة */
    .entry-bar .form-control-xl {
        background: rgba(255, 255, 255, 0.07) !important;
        border: 2px solid rgba(255, 255, 255, 0.15) !important;
        color: #fff !important;
        font-size: 20px !important; /* تكبير الخط */
        font-weight: 700 !important;
        padding: 12px 15px !important;
        border-radius: 12px !important;
        height: auto !important;
        transition: 0.3s;
    }

        .entry-bar .form-control-xl:focus {
            background: rgba(255, 255, 255, 0.12) !important;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2) !important;
        }

    /* تنسيق خاص لحقل الكمية ليبرز */
    #itemQte {
        border-color: rgba(59, 130, 246, 0.4) !important;
        color: #60a5fa !important; /* لون أزرق فاتح مريح */
    }

    /* تنسيق نص "الكمية في المخزن" */
    .stock-info {
        font-size: 13px;
        font-weight: 700;
        margin-top: 8px;
        display: block;
    }

    /* تنسيق زر الإضافة الضخم */
    .btn-add-xl {
        background: #2563eb;
        color: white;
        width: 100%;
        height: 58px; /* نفس ارتفاع الحقول */
        border-radius: 12px;
        font-size: 30px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
    }

        .btn-add-xl:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
        }

    /* تعديل Select2 ليتناسب مع الحجم الجديد */
    .entry-bar .select2-container--default .select2-selection--single {
        background: rgba(255, 255, 255, 0.07) !important;
        border: 2px solid rgba(255, 255, 255, 0.15) !important;
        height: 58px !important;
        border-radius: 12px !important;
        display: flex;
        align-items: center;
    }

    .entry-bar .select2-selection__rendered {
        color: white !important;
        font-size: 18px !important;
        font-weight: 700 !important;
        padding-left: 15px !important;
    }

    .entry-bar .select2-selection__arrow {
        height: 58px !important;
    }
</style>

<div class="val-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary mb-0"><i class="fas fa-calculator me-2"></i> VALEURISATION BSM</h4>
        <button class="btn btn-success fw-bold px-4 rounded-pill shadow-sm"><i class="fas fa-save me-2"></i>Enregistrer le bon</button>
    </div>

    <!-- 1. Header Info (BSM, Date, Chantier) -->
    <div class="header-card shadow-sm">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label-custom">BSM N°</label>
                <input type="text" id="bsmNo" class="form-control fw-bold border-primary" placeholder="000000">
            </div>
            <div class="col-md-3">
                <label class="form-label-custom">Date</label>
                <input type="date" id="bsmDate" class="form-control fw-bold" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-7">
                <label class="form-label-custom">Chantier / Destination (ST_UNITE)</label>
                <select id="chantierSelect" class="form-control"></select>
            </div>
        </div>
    </div>

    <!-- 2. Entry Bar (Product Selection) -->
