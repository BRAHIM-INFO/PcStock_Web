<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- SweetAlert2 CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <title>@ViewData["Title"] - PcStock_Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="app-wrapper">

        @{
            var currentUrl = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

            // تحديد الأقسام النشطة بناءً على المجلدات
            bool isStockSection = currentUrl.StartsWith("/Stocks");
            bool isAchatSection = currentUrl.StartsWith("/Achats");
            bool isCFSection = currentUrl.Contains("/Cessions/Fournie/");
            bool isConsomSection = currentUrl.StartsWith("/Consommations");

            // الأقسام الجديدة
            bool isCRecueSection = currentUrl.Contains("/Cessions/Recue/");
            bool isMoteursSection = currentUrl.StartsWith("/Moteurs");
            bool isCarburantSection = currentUrl.StartsWith("/Carburant");
        }

        <aside class="sidebar-cosider" id="sidebar">

            <!-- 1. اللوجو واسم الشركة -->
            <div class="brand-section d-flex align-items-center justify-content-between">
                <div class="brand-text">
                    <span class="brand-title">COSIDER TP</span>
                    <span class="brand-subtitle">DCM MSILA | PC Stock-Web</span>
                </div>
                <button type="button" id="sidebarToggle" class="btn text-white p-0 border-0">
                    <i class="fas fa-bars" id="toggleIcon"></i>
                </button>
            </div>

            <nav class="nav-list">
                <a asp-page="/Index" class="nav-item @(currentUrl == "/Index" ? "active" : "")">
                    <i class="fas fa-th-large"></i>
                    <span class="menu-text">TABLEAU DE BORD</span>
                </a>

                @* STOCKS *@
                <div class="nav-group">
                    <div class="nav-item has-submenu @(isStockSection ? "parent-active" : "")" id="stockMenuToggle">
                        <i class="fas fa-boxes"></i>
                        <span class="menu-text">STOCKS</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isStockSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isStockSection ? "show" : "")" id="stockSubmenu">
                        <li><a asp-page="/Stocks/Articles" class="submenu-item @(currentUrl == "/Stocks/Articles" ? "active" : "")"><i class="fas fa-list-ul"></i><span class="menu-text">Liste des Articles</span></a></li>
                        <li><a asp-page="/Stocks/Mouvements" class="submenu-item @(currentUrl == "/Stocks/Mouvements" ? "active" : "")"><i class="fas fa-wave-square"></i><span class="menu-text">Mouvements Article</span></a></li>
                        <li><a asp-page="/Stocks/Arrivage" class="submenu-item @(currentUrl == "/Stocks/Arrivage" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text">Arrivage Journalier</span></a></li>
                    </ul>
                </div>

                @* ACHATS *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isAchatSection ? "parent-active" : "")" id="achatMenuToggle">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="menu-text">ACHATS</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isAchatSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isAchatSection ? "show" : "")" id="achatSubmenu">
                        <li><a asp-page="/Achats/NouvBonEntre" class="submenu-item @(currentUrl == "/Achats/NouvBonEntre" ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">NOUVEAU BON ENTREE</span></a></li>
                        <li><a asp-page="/Achats/BEM" class="submenu-item @(currentUrl == "/Achats/BEM" ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">BONS ENTREE MAGASIN</span></a></li>
                        <li><a asp-page="/Achats/Reste" class="submenu-item @(currentUrl == "/Achats/Reste" ? "active" : "")"><i class="fas fa-box-open"></i><span class="menu-text">RESTE EN STOCKS</span></a></li>
                        <li><a asp-page="/Achats/ACHAT_PAR_BEM" class="submenu-item @(currentUrl == "/Achats/ACHAT_PAR_BEM" ? "active" : "")"><i class="fas fa-list-ol"></i><span class="menu-text">ACHATS PAR BEM</span></a></li>
                        <li><a asp-page="/Achats/RECAP_DES_ACHAT" class="submenu-item @(currentUrl == "/Achats/RECAP_DES_ACHAT" ? "active" : "")"><i class="fas fa-poll"></i><span class="menu-text">RECAP DES ACHATS</span></a></li>
                    </ul>
                </div>

                @* CESSION FOURNIE *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isCFSection ? "parent-active" : "")" id="cessionFMenuToggle">
                        <i class="fas fa-file-export"></i>
                        <span class="menu-text">CESSION FOURNIE</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isCFSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isCFSection ? "show" : "")" id="cessionFSubmenu">
                        <li><a asp-page="/Cessions/Fournie/NouveauBSM" class="submenu-item @(currentUrl == "/Cessions/Fournie/NouveauBSM" ? "active" : "")"><i class="fas fa-plus-circle"></i><span class="menu-text">NOUVEAU BSM</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/Valeurisation" class="submenu-item @(currentUrl == "/Cessions/Fournie/Valeurisation" ? "active" : "")"><i class="fas fa-calculator"></i><span class="menu-text">VALEURISATION BSM</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/BonLivraison" class="submenu-item @(currentUrl == "/Cessions/Fournie/BonLivraison" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text">BON DE LIVRAISON</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/BSM" class="submenu-item @(currentUrl == "/Cessions/Fournie/BSM" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">BON SORTIE MAGASIN</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/BSM_PAR_FAMILLE" class="submenu-item @(currentUrl == "/Cessions/Fournie/BSM_PAR_FAMILLE" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">BSM PAR FAMILLE</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/BSM_PAR_CHANTIER" class="submenu-item @(currentUrl == "/Cessions/Fournie/BSM_PAR_CHANTIER" ? "active" : "")"><i class="fas fa-building"></i><span class="menu-text">BSM PAR CHANTIER</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/RecapGeneral" class="submenu-item @(currentUrl == "/Cessions/Fournie/RecapGeneral" ? "active" : "")"><i class="fas fa-clipboard-list"></i><span class="menu-text">RECAP GENERAL</span></a></li>
                    </ul>
                </div>

                @* CONSOMMATIONS *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isConsomSection ? "parent-active" : "")" id="ConsomMenuToggle">
                        <i class="fas fa-file-invoice"></i>
                        <span class="menu-text">CONSOMMATIONS</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isConsomSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isConsomSection ? "show" : "")" id="ConsomSubmenu">
                        <li><a asp-page="/Repports/BilanGlobal" class="submenu-item @(currentUrl == "/Repports/BilanGlobal" ? "active" : "")"><i class="fas fa-plus-circle"></i><span class="menu-text">BilanGlobal</span></a></li>
                        <li><a asp-page="/Consommations/BSM" class="submenu-item @(currentUrl == "/Consommations/BSM" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">BON SORTIE MAGASIN</span></a></li>
                        <li><a asp-page="/Consommations/BSM_PAR_FAMILLE" class="submenu-item @(currentUrl == "/Consommations/BSM_PAR_FAMILLE" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">BSM PAR FAMILLE</span></a></li>
                        <li><a asp-page="/Consommations/RecapGeneral" class="submenu-item @(currentUrl == "/Consommations/RecapGeneral" ? "active" : "")"><i class="fas fa-clipboard-list"></i><span class="menu-text">RECAP GENERAL</span></a></li>
                    </ul>
                </div>

                @* --- الأقسام الجديدة المضافة --- *@

                @* CESSION REÇUE *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isCRecueSection ? "parent-active" : "")" id="cessionRMenuToggle">
                        <i class="fas fa-file-import"></i>
                        <span class="menu-text">CESSION REÇUE</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isCRecueSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isCRecueSection ? "show" : "")" id="cessionRSubmenu">
                        <li><a asp-page="/Cessions/Recue/Nouveau" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/Nouveau") ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">NOUVEAU BON ENTREE</span></a></li>
                        <li><a asp-page="/Cessions/Recue/BEM" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/BEM") ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">BONS ENTREE MAGASIN</span></a></li>
                        <li><a asp-page="/Cessions/Recue/ReintegFamille" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/ReintegFamille") ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">Reintegration PAR Famille</span></a></li>
                        <li><a asp-page="/Cessions/Recue/Recap" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/Recap") ? "active" : "")"><i class="fas fa-poll"></i><span class="menu-text">RECAP DES ACHATS</span></a></li>
                    </ul>
                </div>

                @* MOTEURS & BOITE *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isMoteursSection ? "parent-active" : "")" id="moteursMenuToggle">
                        <i class="fas fa-cogs"></i>
                        <span class="menu-text">MOTEURS & BOITE</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isMoteursSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isMoteursSection ? "show" : "")" id="moteursSubmenu">
                        <li><a asp-page="/Moteurs/Ajouter" class="submenu-item @(currentUrl.Contains("/Moteurs/Ajouter") ? "active" : "")"><i class="fas fa-plus-circle"></i><span class="menu-text">Ajouter Moteur/Boite</span></a></li>
                        <li><a asp-page="/Moteurs/Entrees" class="submenu-item @(currentUrl.Contains("/Moteurs/Entrees") ? "active" : "")"><i class="fas fa-sign-in-alt"></i><span class="menu-text">Liste des Entrees</span></a></li>
                        <li><a asp-page="/Moteurs/Sorties" class="submenu-item @(currentUrl.Contains("/Moteurs/Sorties") ? "active" : "")"><i class="fas fa-sign-out-alt"></i><span class="menu-text">Liste des Sortie</span></a></li>
                    </ul>
                </div>

                @* GESTION CARBURANT *@
                <div class="nav-group mt-2">
                    <div class="nav-item has-submenu @(isCarburantSection ? "parent-active" : "")" id="carburantMenuToggle">
                        <i class="fas fa-gas-pump"></i>
                        <span class="menu-text">GESTION CARBURANT</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon @(isCarburantSection ? "rotate" : "")"></i>
                    </div>
                    <ul class="submenu-list @(isCarburantSection ? "show" : "")" id="carburantSubmenu">
                        <li><a asp-page="/Carburant/Ajouter" class="submenu-item @(currentUrl.Contains("/Carburant/Ajouter") ? "active" : "")"><i class="fas fa-plus-square"></i><span class="menu-text">Ajouter Bon GasOil</span></a></li>
                    </ul>
                </div>

                @* CONFIGURATIONS *@
                <a asp-page="/Settings/Settings"
                   class="nav-link @(currentUrl.Contains("Settings") ? "active bg-white text-primary rounded" : "text-white") d-flex align-items-center py-3 px-4 mb-2">
                    <i class="fas fa-cog me-3"></i>
                    <span class="fw-semibold">CONFIGURATIONS</span>
                </a>
            </nav>

            <div class="sidebar-footer mt-auto">
                <div class="user-box d-flex align-items-center">
                    <div class="user-avatar">CT</div>
                    <div class="user-info ms-2">
                        <span class="u-name">Admin COSIDER</span>
                        <span class="u-unit">Unité: DCM MSILA</span>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main-content w-100">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // وظيفة موحدة لتبديل القوائم وإغلاق الأخريات
            function setupMenuToggle(toggleId, submenuId) {
                $(`#${toggleId}`).on('click', function(e) {
                    e.preventDefault();

                    // إغلاق جميع القوائم الأخرى أولاً (اختياري، إذا كنت تفضل فتح قائمة واحدة فقط)
                    //$('.submenu-list').not(`#${submenuId}`).removeClass('show');
                    //$('.arrow-icon').not($(this).find('.arrow-icon')).removeClass('rotate');

                    $(`#${submenuId}`).toggleClass('show');
                    $(this).find('.arrow-icon').toggleClass('rotate');
                });
            }

            // تفعيل جميع القوائم
            setupMenuToggle('stockMenuToggle', 'stockSubmenu');
            setupMenuToggle('achatMenuToggle', 'achatSubmenu');
            setupMenuToggle('cessionFMenuToggle', 'cessionFSubmenu');
            setupMenuToggle('ConsomMenuToggle', 'ConsomSubmenu');
            setupMenuToggle('cessionRMenuToggle', 'cessionRSubmenu');
            setupMenuToggle('moteursMenuToggle', 'moteursSubmenu');
            setupMenuToggle('carburantMenuToggle', 'carburantSubmenu');

            // التحكم في انهيار الشريط الجانبي بالكامل
              $('#sidebarToggle').on('click', function () {
            const sidebar = $('#sidebar');
            const icon = $('#toggleIcon');

            sidebar.toggleClass('collapsed');

            // تغيير شكل الأيقونة من قضبان (bars) إلى سهم (chevron)
            if (sidebar.hasClass('collapsed')) {
                icon.removeClass('fa-bars').addClass('fa-chevron-right');
            } else {
                icon.removeClass('fa-chevron-right').addClass('fa-bars');
            }
            });
            
            // ملاحظة: إذا كان السايدبار مغلقاً، نمنع الضغط على المجموعات لفتح الساب منيو
            $('.nav-item.has-submenu').on('click', function(e) {
                if ($('#sidebar').hasClass('collapsed')) {
                    e.preventDefault();
                    $('#sidebar').removeClass('collapsed'); // يفتح السايدبار أولاً عند الضغط
                    $('#toggleIcon').replaceClass('fa-chevron-right', 'fa-bars');
                }
            });
            
            // $('#sidebarToggle').on('click', function () {
            //     $('#sidebar').toggleClass('collapsed');
            //     const icon = $('#toggleIcon');
            //     if ($('#sidebar').hasClass('collapsed')) {
            //         icon.removeClass('fa-bars').addClass('fa-chevron-right');
            //     } else {
            //         icon.removeClass('fa-chevron-right').addClass('fa-bars');
            //     }
            // });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

 