<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- SweetAlert2 CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <title>@ViewData["Title"] - PcStock_Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="app-wrapper">

        @{
            var currentUrl = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

            // تحديد الأقسام النشطة بناءً على المجلدات
            bool isStockSection = currentUrl.StartsWith("/Stocks");
            bool isAchatSection = currentUrl.StartsWith("/Achats");
            bool isCFSection = currentUrl.Contains("/Cessions/Fournie/");
            bool isConsomSection = currentUrl.StartsWith("/Consommations");

            // الأقسام الجديدة
            bool isCRecueSection = currentUrl.Contains("/Cessions/Recue/");
            bool isMoteursSection = currentUrl.StartsWith("/Moteurs");
            bool isCarburantSection = currentUrl.StartsWith("/Carburant");
        }

           
        @{
            var activePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        }  

        <aside class="sidebar-cosider" id="sidebar">
          
                <!-- قسم اللوجو مع زر الإغلاق -->
            <div class="brand-section d-flex align-items-center justify-content-between px-3">
                <div class="brand-text">
                    <img src="/images/logo_entreprise.png" style="max-height: 40px;" alt="Logo">
                </div>
               @*  <button type="button" id="sidebarToggle" class="btn text-primary border-0 p-0">
                    <i class="fas fa-bars fa-lg" id="toggleIcon"></i>
                </button> *@
            </div>

            <nav class="nav-list">
                <!-- TABLEAU DE BORD -->
                <a asp-page="/Index" class="nav-item @(activePage == "/Index" ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i>
                    <span class="menu-text">TABLEAU DE BORD</span>
                </a>

                <!-- Fichier Stocks -->
                   @* STOCKS *@
                <div class="nav-group">
                    <div class="nav-item-toggle">
                        <i class="fas fa-boxes"></i>
                        <span>Fichier Stocks</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list @(isStockSection ? "show" : "")" id="stockSubmenu">
                        <li><a asp-page="/Stocks/Articles" class="submenu-item @(currentUrl == "/Stocks/Articles" ? "active" : "")"><i class="fas fa-list-ul"></i><span class="menu-text">Liste des Articles</span></a></li>
                        <li><a asp-page="/Stocks/Mouvements" class="submenu-item @(currentUrl == "/Stocks/Mouvements" ? "active" : "")"><i class="fas fa-wave-square"></i><span class="menu-text">Mouvements Article</span></a></li>
                        <li><a asp-page="/Stocks/Arrivage" class="submenu-item @(currentUrl == "/Stocks/Arrivage" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text">Arrivage Journalier</span></a></li>
                        <li><a asp-page="/Repports/BilanGlobal" class="submenu-item @(currentUrl == "/Repports/BilanGlobal" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text">BilanGlobal</span></a></li>
                        <li><a asp-page="/Stocks/ListeStock" class="submenu-item @(currentUrl == "/Stocks/ListeStock" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text">État d'Inventaire</span></a></li>
 
                    </ul>
                </div>
                 

                <!-- Achats --> 
                 <div class="nav-group mt-2">
                     <div class="nav-item-toggle">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Achats</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list @(isAchatSection ? "show" : "")" id="achatSubmenu">
                        <li><a asp-page="/Achats/NouvBonEntre" class="submenu-item @(currentUrl == "/Achats/NouvBonEntre" ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">Nouveau Bon Entrée</span></a></li>
                        <li><a asp-page="/Achats/BEM" class="submenu-item @(currentUrl == "/Achats/BEM" ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text"> Bon De Retour</span></a></li>
                        <li><a asp-page="/Achats/BEM" class="submenu-item @(currentUrl == "/Achats/BEM" ? "active" : "")"><i class="fas fa-box-open"></i><span class="menu-text"> Liste des Achats</span></a></li>
                        <li><a asp-page="/Achats/Reste" class="submenu-item @(currentUrl == "/Achats/Reste" ? "active" : "")"><i class="fas fa-list-ol"></i><span class="menu-text">  Reste En Stocks</span></a></li>
                    </ul>
                </div> 

                <!-- Cession Fournie -->
                <div class="nav-group">
                    <div class="nav-item-toggle">
                        <i class="fas fa-file-export"></i>
                        <span>Cession Fournie</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list @(isCFSection ? "show" : "")" id="cessionFSubmenu">
                        <li><a asp-page="/Cessions/Fournie/NouveauBSM" class="submenu-item @(currentUrl == "/Cessions/Fournie/NouveauBSM" ? "active" : "")"><i class="fas fa-plus-circle"></i><span class="menu-text">Nouveau Bon Sortie</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/Valeurisation" class="submenu-item @(currentUrl == "/Cessions/Fournie/Valeurisation" ? "active" : "")"><i class="fas fa-calculator"></i><span class="menu-text"> Bon De Retour</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/BSM" class="submenu-item @(currentUrl == "/Cessions/Fournie/BSM" ? "active" : "")"><i class="fas fa-truck"></i><span class="menu-text"> Liste Cessions Fournie</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/Valeurisation" class="submenu-item @(currentUrl == "/Cessions/Fournie/Valeurisation" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text"> Valorisation de BSM</span></a></li>
                        <li><a asp-page="/Cessions/Fournie/Valeurisation" class="submenu-item @(currentUrl == "/Cessions/Fournie/Valeurisation" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text"> Bon De Livraison</span></a></li>
                    </ul> 
                </div>

                <!-- Cession Reçue -->
                <div class="nav-group">
                    <div class="nav-item-toggle">
                        <i class="fas fa-file-import"></i>
                        <span>Cession Reçue</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list @(isCRecueSection ? "show" : "")" id="cessionRSubmenu">
                        <li><a asp-page="/Cessions/Recue/Nouveau" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/Nouveau") ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text">Nouveau Bon Entrée</span></a></li>
                        <li><a asp-page="/Cessions/Recue/BEM" class="submenu-item @(currentUrl.Contains("/Cessions/Recue/BEM") ? "active" : "")"><i class="far fa-file-alt"></i><span class="menu-text"> Liste Cessions Recue</span></a></li>
                    </ul> 
                </div>

                <!-- Consommations -->
                <div class="nav-group">
                    <div class="nav-item-toggle">
                        <i class="fas fa-gas-pump"></i>
                        <span>Consommations</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list @(isConsomSection ? "show" : "")" id="ConsomSubmenu">
                        <li><a asp-page="/Repports/BilanGlobal" class="submenu-item @(currentUrl == "/Repports/BilanGlobal" ? "active" : "")"><i class="fas fa-plus-circle"></i><span class="menu-text">Nouveau Bon Sortie</span></a></li>
                        <li><a asp-page="/Consommations/BSM" class="submenu-item @(currentUrl == "/Consommations/BSM" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text"> Bon De Retour</span></a></li>
                        <li><a asp-page="/Consommations/BSM" class="submenu-item @(currentUrl == "/Consommations/BSM" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">Liste Consommations</span></a></li>
                    </ul> 
                </div>

                <!-- REPPORTS -->
                <div class="nav-group">
                    <div class="nav-item-toggle">
                        <i class="fas fa-chart-pie"></i>
                        <span>RAPPORTS</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list">
                        <div class="report-label">Achats  </div>
                        <li><a asp-page="/Reports/AchatBEM"   class="submenu-item"><i class="fas fa-circle-notch"></i> Achat Par BEM</a></li>
                        <li><a asp-page="/Reports/RecapAchat" class="submenu-item"><i class="fas fa-circle-notch"></i>  Achat Par Fournisseur</a></li>
                        <li><a asp-page="/Reports/RecapAchat" class="submenu-item"><i class="fas fa-circle-notch"></i>  Achat Par Famille</a></li>
                        <li><a asp-page="/Reports/RecapAchat" class="submenu-item"><i class="fas fa-circle-notch"></i>  Synthèse des Achats </a></li>
                        <li><a asp-page="/Reports/RecapAchat" class="submenu-item"><i class="fas fa-circle-notch"></i>  Récap des Achats</a></li>


                        <div class="report-label">Cession Fournie</div>
                        <li><a asp-page="/Reports/CF_Famille" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession FR / BSM</a></li>
                        <li><a asp-page="/Reports/CF_Famille" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession FR / Projet</a></li>
                        <li><a asp-page="/Reports/CF_Famille" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession FR / Famille </a></li>
                        <li><a asp-page="/Reports/CF_Famille" class="submenu-item"><i class="fas fa-circle-notch"></i> Synthèse des Cession FR </a></li>
                        <li><a asp-page="/Reports/CF_Famille" class="submenu-item"><i class="fas fa-circle-notch"></i> Récap des Cession FR </a></li>


                        <div class="report-label">Consommation</div>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Consommation / BSM</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Consommation  / Projet</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Consommation  / Famille</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Synthèse Consommation </a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Récap Consommation </a></li>
                 
                        <div class="report-label">Cession Reçue</div>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession Reçue / BEM</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession Reçue / Projet</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Cession Reçue / Famille</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Synthèse Cession Reçue </a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Récap Cession Reçue </a></li>

                        <div class="report-label">Sortie Exceptions</div>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Sortie Exceptions / BEM</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Sortie Exceptions / Imputation</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Sortie Exceptions / Famille</a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Synthèse Sortie Exceptions </a></li>
                        <li><a asp-page="/Reports/SynthConso" class="submenu-item"><i class="fas fa-circle-notch"></i> Récap Sortie Exceptions </a></li>

                        <div class="report-label">Rapport general des stocks</div>
                        <li><a asp-page="/Reports/BilanGlobal" class="submenu-item @(currentUrl == "/Reports/BilanGlobal" ? "active" : "")"><i class="fas fa-layer-group"></i><span class="menu-text">Bilan Global de Stock</span></a></li>

                        @* <li><a asp-page="/Reports/BilanGlobal" class="submenu-item"><i class="fas fa-circle-notch"></i> Bilan Global de Stock</a></li> *@
                    </ul>
                </div>

                <!-- Tableaux -->
                @* Tableaux ------------------------------------------------------------- *@
                <div class="nav-group mt-2">
                    <div class="nav-item-toggle" data-target="tableSub">
                        <i class="fas fa-table"></i>
                        <span>Tableaux</span>
                        <i class="fas fa-chevron-down ms-auto arrow-icon"></i>
                    </div>
                    <ul class="submenu-list" id="tableSub">
                        @* الموردين *@
                        <li>
                            <a asp-page="/Tables/Fournisseurs" class="submenu-item @(activePage == "/Tables/Fournisseurs" ? "active" : "")">
                                <i class="fas fa-user-tie"></i>
                                <span class="menu-text">Fournisseurs</span>
                            </a>
                        </li>
                        @* المشاريع *@
                        <li>
                            <a asp-page="/Tables/Projets" class="submenu-item @(activePage == "/Tables/Projets" ? "active" : "")">
                                <i class="fas fa-project-diagram"></i>
                                <span class="menu-text">Projets</span>
                            </a>
                        </li>
                        @* الهياكل / الوحدات *@
                        <li>
                            <a asp-page="/Tables/Structures" class="submenu-item @(activePage == "/Tables/Structures" ? "active" : "")">
                                <i class="fas fa-sitemap"></i>
                                <span class="menu-text">Structures</span>
                            </a>
                        </li>
                        @* مجموعات العوائل *@
                        <li>
                            <a asp-page="/Tables/GroupeFamille" class="submenu-item @(activePage == "/Tables/GroupeFamille" ? "active" : "")">
                                <i class="fas fa-folder-tree"></i>
                                <span class="menu-text">Groupe de Famille</span>
                            </a>
                        </li>
                        @* عوائل المواد *@
                        <li>
                            <a asp-page="/Tables/FamilleArticle" class="submenu-item @(activePage == "/Tables/FamilleArticle" ? "active" : "")">
                                <i class="fas fa-tags"></i>
                                <span class="menu-text">Famille Article</span>
                            </a>
                        </li>
                        @* جدول الاستثناءات *@
                        <li>
                            <a asp-page="/Tables/Exceptions" class="submenu-item @(activePage == "/Tables/Exceptions" ? "active" : "")">
                                <i class="fas fa-file-shield"></i>
                                <span class="menu-text">Table Exception</span>
                            </a>
                        </li>
                    </ul>
                </div>
                



                <!-- CONFIGURATIONS -->
                <a asp-page="/Settings/Settings" class="nav-item @(activePage.Contains("Settings") ? "active" : "")" style="background: rgba(0,0,0,0.15); margin-top: 10px;">
                    <i class="fas fa-cog"></i>
                    <span class="menu-text">CONFIGURATIONS</span>
                </a>
            </nav>
             
        </aside> 
        <main class="main-content w-100">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // وظيفة التبديل (فتح وإغلاق القوائم)
            $('.nav-item-toggle').on('click', function(e) {
                e.preventDefault();
                const $submenu = $(this).next('.submenu-list');
                const $arrow = $(this).find('.arrow-icon');

                // إغلاق القوائم الأخرى المفتوحة تلقائياً (Accordion Effect)
                $('.submenu-list').not($submenu).slideUp(300);
                $('.arrow-icon').not($arrow).removeClass('rotate');

                // تبديل حالة القائمة الحالية
                $submenu.slideToggle(300);
                $arrow.toggleClass('rotate');
            });

            // إبقاء القائمة النشطة مفتوحة عند تحميل الصفحة
            $('.submenu-item.active').closest('.submenu-list').show();
            $('.submenu-item.active').closest('.nav-group').find('.arrow-icon').addClass('rotate');
        });
    </script>
    <script>
        $(document).ready(function() {
            const $sidebar = $('#sidebar');
            const $toggleIcon = $('#toggleIcon');

            // زر التبديل الرئيسي
            $('#sidebarToggle').on('click', function() {
                $sidebar.toggleClass('collapsed');

                if ($sidebar.hasClass('collapsed')) {
                    $toggleIcon.removeClass('fa-bars').addClass('fa-chevron-right');
                    $('.submenu-list').slideUp(0).removeClass('show'); // إغلاق القوائم المفتوحة
                } else {
                    $toggleIcon.removeClass('fa-chevron-right').addClass('fa-bars');
                }
            });

            // إذا ضغط المستخدم على أيقونة والسايدبار مغلق، نقوم بفتحه أولاً
            $('.nav-item, .nav-item-toggle').on('click', function() {
                if ($sidebar.hasClass('collapsed')) {
                    $sidebar.removeClass('collapsed');
                    $toggleIcon.removeClass('fa-chevron-right').addClass('fa-bars');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

 