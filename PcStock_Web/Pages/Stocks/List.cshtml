@page
@model PcStock_Web.Pages.Stocks.ListModel
@{
    ViewData["Title"] = "LISTE DES STOCKS";
}

<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 shadow-sm border-bottom">
    <h4 class="fw-bold mb-0">LISTE DES STOCKS</h4>
    <button class="btn btn-primary shadow-sm">
        <i class="fas fa-print me-2"></i>Imprimer
    </button>
</div>

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="text-primary fw-bold mb-4">Liste Des Articles</h5>
             
            <div class="d-flex justify-content-between align-items-center mb-3">
               <div class="d-flex align-items-center">
                   <span class="me-2 fw-bold">Afficher</span>
                   <select class="form-select form-select-sm w-auto" 
                           onchange="location.href='?PageSize=' + this.value + '&CurrentPage=1'">
                       <option value="10" selected="@(Model.PageSize == 10)">10</option>
                       <option value="20" selected="@(Model.PageSize == 20)">20</option>
                       <option value="50" selected="@(Model.PageSize == 50)">50</option>
                   </select>
                   <span class="ms-2 fw-bold">entrées</span>
               </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover border shadow-sm" id="stockTable">
                    <thead class="bg-light shadow-sm">
                        <tr class="text-uppercase small fw-bold">
                            <th>REF <i class="fas fa-sort"></i></th>
                            <th>CODE_INT <i class="fas fa-sort"></i></th>
                            <th>INTITULE <i class="fas fa-sort"></i></th>
                            <th>FAMILLE <i class="fas fa-sort"></i></th>
                            <th class="text-center">QTE <i class="fas fa-sort"></i></th>
                            <th class="text-end">PAMP <i class="fas fa-sort"></i></th>
                            <th>DATE_MAJ <i class="fas fa-sort"></i></th>
                        </tr>
                       @*  <tr class="filter-row bg-white">
                            <th><input type="text" class="form-control form-control-sm border-0 bg-light" onkeyup="filter(0, this.value)"></th>
                            <th><input type="text" class="form-control form-control-sm border-0 bg-light" onkeyup="filter(1, this.value)"></th>
                            <th><input type="text" class="form-control form-control-sm border-0 bg-light" onkeyup="filter(2, this.value)"></th>
                            <th><input type="text" class="form-control form-control-sm border-0 bg-light" onkeyup="filter(5, this.value)"></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr> *@
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Inventory)
                        {
                            <tr>
                                <td class="fw-bold">@item.REF</td>
                                <td>@item.CODE_INT</td>
                                <td>@item.INTITULE</td>
                                <td>@item.FAMILLE</td>
                                <td class="text-center @(item.QTE <= 0 ? "text-danger" : "")">@item.QTE</td>
                                <td class="text-end">@item.PAMP.ToString("N2")</td>
                                <td class="small">@item.DATE_MAJ?.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div> 

            <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-2">
               <div class="text-secondary small">
                   Affichage de @(((Model.CurrentPage - 1) * Model.PageSize) + 1) à 
                   @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) sur @Model.TotalItems
               </div>
               
               <nav>
                   <ul class="pagination pagination-sm mb-0">
                       <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                           <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-PageSize="@Model.PageSize">Précédent</a>
                       </li>
              
                       @for (int i = 1; i <= Math.Min(Model.TotalPages, 5); i++)
                       {
                           <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                               <a class="page-link" asp-route-CurrentPage="@i" asp-route-PageSize="@Model.PageSize">@i</a>
                           </li>
                       }
              
                       <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                           <a class="page-link" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-PageSize="@Model.PageSize">Suivant</a>
                       </li>
                   </ul>
               </nav>
            </div> 
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#stockTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json" // تعريب الواجهة للفرنسية كما في صورتك
                },
                "pageLength": 10,
                "ordering": true,
                "responsive": true
            });
        });
    </script>
}