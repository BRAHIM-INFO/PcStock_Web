        // دالة تحضير البيانات للمودال
          // لا تنسَ وضع دالة openEditModal خارج الـ $(document).ready لتكون عامة (Global)
   
        function prepareEdit(ref) {
            var table = $('#stockTable').DataTable();
            // البحث عن السطر في ذاكرة الجدول
            var rowData = table.rows().data().toArray().find(x => x.ref === ref);

                 if (rowData) {
            // --- 1. ملء بيانات التبويب الأول (Identification) ---
            $('#displayRef').text(rowData.ref);
            $('#editREF').val(rowData.ref);
            $('#editINTITULE').val(rowData.intitule);
            $('#editINTITULE2').val(rowData.intitule2 || "");
            $('#editINTITULE3').val(rowData.intitule3 || "");
            $('#editFAMILLE').val(rowData.famille || "");
            $('#editLIEU_STO').val(rowData.lieU_STO || "");
            $('#editCASIER').val(rowData.casier || "");

            // --- 2. ملء بيانات التبويب الثاني (Stock & Prix) ---
            $('#editQTE').val(rowData.qte);
            $('#editPAMP').val(rowData.pamp);
            $('#editPRIX_ACH').val(rowData.priX_ACH || rowData.prixAch || 0);
            $('#editSTOCK_INI').val(rowData.stocK_INI || rowData.stockIni || 0);
            $('#editVALEUR_INI').val(rowData.valeuR_INI || rowData.valeurIni || 0);
            $('#editSTOCK_MAX').val(rowData.stocK_MAX || rowData.stockMax || 0);
            $('#editSTOCK_SEC').val(rowData.stocK_SEC || rowData.stockSec || 0);

            // تنسيق التاريخ ليعمل مع حقل input type="date"
            if (rowData.datE_MAJ || rowData.dateMaj) {
                let dateVal = rowData.datE_MAJ || rowData.dateMaj;
                $('#editDATE_MAJ').val(new Date(dateVal).toISOString().split('T')[0]);
            }

            // --- 3. ملء بيانات التبويب الثالث (Statistiques) ---
            // دالة مساعدة لتنسيق الأرقام
            const formatNum = (num) => parseFloat(num || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 });

            // تفعيل الأسطر التي كانت معطلة مع تصحيح اسم الكائن إلى rowData
            $('#editENTREES').val(rowData.entrees || 0);
            $('#editSORTIES').val(rowData.sorties || 0);

            $('#editQTE_ENT').val(formatNum(rowData.qtE_ENT || rowData.qteEnt));
            $('#editQTE_SOR').val(formatNum(rowData.qtE_SOR || rowData.qteSor));
            $('#editTEMPVAL').val(formatNum(rowData.tempval) + " DA");

            $('#editACHAT_HT').val(formatNum(rowData.achaT_HT || rowData.achatHt));
            $('#editCONSO_HT').val(formatNum(rowData.consO_HT || rowData.consoHt));
            $('#editCESS_HT').val(formatNum(rowData.cesS_HT || rowData.cessHt));
            $('#editCESSR_HT').val(formatNum(rowData.cessR_HT || rowData.cessrHt));

            // فتح النافذة
            $('#editArticleModal').modal('show');
        }
