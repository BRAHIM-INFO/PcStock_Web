            { 
                "data": "stock_ini", "className": "text-end",
                "render": function(data){ return parseFloat(data).toLocaleString('fr-FR', {minimumFractionDigits: 2}); }
            },
            { "data": "casier" },
            { "data": "date_maj" },
            {
                "data": null,
                "className": "text-center",
                "render": function(data, type, row) {
                    return `<button type="button" class="btn btn-primary btn-sm" onclick="prepareEdit('${row.ref}')">
                                <i class="fas fa-edit"></i>
                            </button>`;
                }
            }
        ]
    });
});

