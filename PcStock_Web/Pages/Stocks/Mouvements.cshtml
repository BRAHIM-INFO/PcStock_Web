@page
@model PcStock_Web.Pages.Stocks.MouvementsModel
@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .fiche-container {
        background: #f8fafc;
        min-vh-100;
        padding: 20px;
    }

    .header-info {
        background: white;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 20px;
        margin-bottom: 20px;
    }

    .label-custom {
        font-size: 11px;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 5px;
        display: block;
    }

    .info-val {
        font-weight: 700;
        color: #1e293b;
        font-size: 16px;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 3px;
        display: block;
    }

    /* تصميم الجدول */
    .table-card {
        background: white;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    #mouvTable thead th {
        background: #1e40af;
        color: white;
        font-size: 12px;
        padding: 12px;
    }

    /* شاشة LCD للرصيد الحالي */
    .lcd-screen {
        background: #050505;
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 55px;
        padding: 10px 30px;
        border-radius: 10px;
        border: 4px solid #334155;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
        text-align: right;
    }
    /* تنسيق حقل البحث داخل الشريط الأزرق */
    .select2-container--default .select2-selection--single {
        border: none !important;
        height: 35px !important;
        display: flex !important;
        align-items: center !important;
        font-weight: bold !important;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-dropdown {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 10px 15px rgba(0,0,0,0.1);
    }
</style>

<div class="fiche-container">
   @*  <div class="top-toolbar d-flex justify-content-between align-items-center bg-primary text-white p-3 rounded-3 mb-3 shadow">
        <h4 class="mb-0 fw-bold"><i class="fas fa-history me-2"></i> FICHE MOUVEMENT ARTICLE</h4>
        <div class="d-flex align-items-center bg-white rounded-2 px-2 py-1" style="width: 350px;">
            <span class="text-dark fw-bold me-2 small">RECHERCHER:</span>
            <select id="refSearch" class="form-control border-0"></select>
        </div>
    </div> *@

    <!-- Toolbar -->
    <div class="top-toolbar d-flex justify-content-between align-items-center bg-primary text-white p-3 rounded-3 mb-3 shadow">
        <div class="d-flex align-items-center">
            <i class="fas fa-file-invoice-dollar fa-2x me-3"></i>
            <h3 class="mb-0 fw-bold">FICHE MOUVEMENT ARTICLE</h3>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <!-- ربط الأزرار بالـ IDs البرمجية -->
            <button id="btnPrint" class="btn btn-action btn-light text-primary shadow-sm">
                <i class="fas fa-print me-2"></i>Imprimer
            </button>
            <button id="btnExcel" class="btn btn-action btn-success shadow-sm">
                <i class="fas fa-file-excel me-2"></i>Excel
            </button>
            <div class="ms-2 bg-white rounded-3 p-1 d-flex align-items-center" style="width: 250px;">
                <span class="text-dark fw-bold px-2 small">RECHERCHER:</span>
                <select id="refSearch" class="form-control border-0"></select>
            </div>
        </div>
    </div>


    <!-- بطاقة معلومات السلعة -->
    <div class="header-info shadow-sm">
        <div class="row text-center">
            <div class="col-md-2"><span class="label-custom">Référence</span><span id="resRef" class="info-val">---</span></div>
            <div class="col-md-4"><span class="label-custom">Désignation</span><span id="resDesig" class="info-val text-primary">---</span></div>
            <div class="col-md-2"><span class="label-custom">Famille</span><span id="resFam" class="info-val">---</span></div>
            <div class="col-md-2"><span class="label-custom">Casier</span><span id="resCas" class="info-val text-warning">---</span></div>
            <div class="col-md-2"><button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="window.print()"><i class="fas fa-print"></i> Imprimer</button></div>
        </div>
    </div>

    <div class="card table-card">
        <table id="mouvTable" class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ORD</th>
                    <th>DATE</th>
                    <th class="text-center">QTE ENTREE</th>
                    <th class="text-center">QTE SORTIE</th>
                    <th class="text-center">EN STOCK</th>
                    <th class="text-end">PAMP</th>
                    <th>FOURNISSEUR / UNITE</th>
                    <th>TYPE</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end align-items-center mt-4 gap-3">
        <span class="fw-bold text-muted">STOCK ACTUEL</span>
        <div class="lcd-screen" id="currentStock">0.00</div>
    </div>
</div>
 
@section Scripts {
    <!-- 1. استدعاء المكتبات الضرورية (تأكد من وجودها) -->
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/scroller/2.2.0/js/dataTables.scroller.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script>
        $(document).ready(function () {

            // دالة مساعدة لتنسيق المبالغ المالية
            const formatNumber = (num) => {
                return parseFloat(num || 0).toLocaleString('fr-FR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            };

            // 2. تهيئة جدول الحركات (DataTable) - يكون فارغاً عند البداية
            var table = $('#mouvTable').DataTable({
                paging: true,
                deferRender: true,
                scrollY: "400px",
                scrollCollapse: true,
                scroller: true,
                dom: 'rt', // إظهار الجدول فقط بدون إضافات
                 buttons: [
                    {
                        extend: 'excelHtml5',
                        className: 'd-none',
                        title: () => 'Mouvement_' + ($('#refSearch').val() || 'Global'),
                        exportOptions: { columns: ':visible' }
                    }
                ],
                columns: [
                    { data: 'ord', className: 'text-center small text-muted' },
                    {
                        data: 'date',
                        render: function(data) {
                            if(!data) return '-';
                            var d = new Date(data);
                            return ("0" + d.getDate()).slice(-2) + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        }
                    },
                    {
                        data: 'qte_entre',
                        className: 'text-center fw-bold text-success',
                        render: function(data) { return data > 0 ? formatNumber(data) : ''; }
                    },
                    {
                        data: 'qte_sortie',
                        className: 'text-center fw-bold text-danger',
                        render: function(data) { return data > 0 ? formatNumber(data) : ''; }
                    },
                    {
                        data: 'en_stock',
                        className: 'text-center fw-bold bg-light',
                        render: function(data) { return formatNumber(data); }
                    },
                    {
                        data: 'pamp',
                        className: 'text-end',
                        render: function(data) { return formatNumber(data); }
                    },
                    { data: 'entity', defaultContent: '---' },
                    {
                        data: 'type',
                        render: function(data) {
                            let badgeClass = data === 'ACHAT' || data === 'REINTEG' ? 'bg-success' : 'bg-primary';
                            return `<span class="badge ${badgeClass} opacity-75" style="font-size:10px;">${data}</span>`;
                        }
                    }
                ],
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json" }
            });

            // 3. تهيئة محرك البحث التلقائي (Autocomplete)
            $('#refSearch').select2({
                placeholder: "🔍 Saisir Référence ou Désignation...",
                minimumInputLength: 1,
                allowClear: true,
                ajax: {
                    url: '?handler=ArticleAutocomplete', // الدالة التي برمجناها في الـ Backend
                    delay: 300,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return { results: data.results };
                    }
                }
            });

            // 4. الحدث: عند اختيار منتج من القائمة المنسدلة
            $('#refSearch').on('select2:select', function (e) {
                const item = e.params.data;

                // أ. تحديث بطاقة المعلومات العلوية فوراً
                $('#resRef').text(item.id).addClass('text-primary');
                $('#resDesig').text(item.intitule);
                $('#resFam').text(item.famille);
                $('#resCas').text(item.casier);

                // ب. إظهار مؤشر تحميل بسيط
                Swal.showLoading();

                // ج. طلب جلب الحركات التاريخية من السيرفر
                $.ajax({
                    url: '?handler=LoadMouvements',
                    type: 'GET',
                    data: { refArt: item.id },
                    success: function (data) {
                        Swal.close(); // إغلاق مؤشر التحميل

                        // مسح البيانات القديمة وإضافة الجديدة
                        table.clear().rows.add(data).draw();

                        // د. تحديث شاشة الـ LCD بأحدث رصيد مخزن (آخر سطر في الجدول)
                        if (data && data.length > 0) {
                            let lastRecord = data[data.length - 1];
                            $('#currentStock').text(formatNumber(lastRecord.en_stock));
                        } else {
                            $('#currentStock').text('0,00');
                            Swal.fire({
                                icon: 'info',
                                title: 'Info',
                                text: 'Aucun mouvement enregistré pour cet article.',
                                timer: 2000
                            });
                        }
                    },
                    error: function () {
                        Swal.fire('Erreur', 'Impossible de charger les mouvements.', 'error');
                    }
                });
            });

            // 5. عند مسح البحث (Clear)
            $('#refSearch').on('select2:clear', function() {
                $('#resRef, #resDesig, #resFam, #resCas').text('---');
                $('#currentStock').text('0,00');
                table.clear().draw();
            });

              // ربط أزرار الطباعة والإكسل
            $('#btnPrint').on('click', () => window.print());
            $('#btnExcel').on('click', () => table.button('.buttons-excel').trigger());
        });
    </script>
}