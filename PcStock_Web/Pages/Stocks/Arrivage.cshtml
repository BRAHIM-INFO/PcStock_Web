@page
@model PcStock_Web.Pages.Stocks.ArrivageModel
@{
    ViewData["Title"] = "Arrivage Journalier";
}

<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 shadow-sm">
    <h4 class="fw-bold mb-0">Arrivage Journalier</h4>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Félicitations!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div>
        <button class="btn btn-success me-2"><i class="fas fa-file-excel me-2"></i>Exporter Excel</button>
        <button class="btn btn-dark"><i class="fas fa-print me-2"></i>Imprimer Liste</button>
    </div>
</div>

<div class="container-fluid">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-secondary fw-bold"><i class="fas fa-plus me-2"></i>NOUVELLE ENTRÉE</h6>
        </div>
        <div class="card-body">
            <form method="post" class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="form-control bg-light" placeholder="AUTO (Next: 1)" readonly>
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.REF" type="text" class="form-control" placeholder="REF">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.DESIGNATION" type="text" class="form-control" placeholder="DESIGNATION">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.MACHINE" type="text" class="form-control" placeholder="MACHINE">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.QTE" type="number" class="form-control" placeholder="QTE">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.PRIX" type="number" class="form-control" placeholder="PRIX">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.FOURNISSEUR" type="text" class="form-control" placeholder="FOURNISSEUR">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.FACT_N" type="text" class="form-control" placeholder="FACT_N">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.BC_N" type="text" class="form-control" placeholder="BC_N">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.CASIER" type="text" class="form-control" placeholder="CASIER">
                </div>
                <div class="col-md-3">
                    <input asp-for="NewEntry.ACHETTEUR" type="text" class="form-control" placeholder="ACHETTEUR">
                </div>
                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        <i class="fas fa-save me-2"></i>Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
                <input type="text" class="form-control w-25" placeholder="Rechercher...">
                <div class="d-flex align-items-center">
                    <span class="me-2 small">DU:</span><input type="date" class="form-control form-control-sm me-3">
                    <span class="me-2 small">AU:</span><input type="date" class="form-control form-control-sm">
                </div>
            </div>


            <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-2 rounded">
            <div class="d-flex align-items-center">
                <label class="me-2 small fw-bold">Afficher</label>
                <select class="form-select form-select-sm w-auto" 
                        onchange="location.href='?PageSize=' + this.value + '&CurrentPage=1'">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                </select>
                <label class="ms-2 small fw-bold">entrées</label>
           </div>
          </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle border-top">
                    <thead class="bg-light small">
                        <tr class="text-uppercase small fw-bold text-secondary">
                            <th class="border-bottom-0">ORD <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">DATE <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">REF <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">DESIGNATION <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">MACHINE <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0 text-center">QTE <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0 text-end">PRIX <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">FOURNISSEUR <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">FACT N° <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">BC N° <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">CASIER <i class="fas fa-sort ms-1 opacity-50"></i></th>
                            <th class="border-bottom-0">ACHETTEUR <i class="fas fa-sort ms-1 opacity-50"></i></th>
                        </tr> 
                    </thead>
                    <tbody class="small">
                        @if (Model.SavedEntries.Any())
                        {
                            foreach (var item in Model.SavedEntries)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@item.Ord</td>
                                    <td>@item.Dates</td>
                                    <td>@item.REF</td>
                                    <td>@item.DESIGNATION</td>
                                    <td>@item.MACHINE</td>
                                    <td class="text-center">@item.QTE</td>
                                    <td class="text-end">@item.PRIX.ToString("N2") DA</td>
                                    <td>@item.FOURNISSEUR</td>
                                    <td>@item.FACT_N</td>
                                    <td>@item.BC_N</td>
                                    <td>@item.CASIER</td>
                                    <td>@item.ACHETTEUR</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle me-2"></i>Aucune donnée trouvée
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        
            <div class="d-flex justify-content-between align-items-center mt-3 p-2 border-top">
                <div class="small text-secondary">
                    Affichage de @(((Model.CurrentPage - 1) * Model.PageSize) + 1) à
                    @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) sur @Model.TotalItems
                </div>

                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link shadow-none" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-PageSize="@Model.PageSize">Précédent</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link shadow-none" asp-route-CurrentPage="@i" asp-route-PageSize="@Model.PageSize">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link shadow-none" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-PageSize="@Model.PageSize">Suivant</a>
                        </li>
                    </ul>
                </nav>
            </div>
        
        </div>
    </div> 
</div>
 