        font-weight: 700;
        height: 40px !important;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        justify-content: center;
    }

    .btn-table {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 1px solid transparent;
    }

    .btn-edit-s {
        background: #eff6ff;
        color: #2563eb;
        border-color: #dbeafe;
    }

    .btn-delete-s {
        background: #fef2f2;
        color: #ef4444;
        border-color: #fee2e2;
    }

    /* --- تنسيقات الطباعة الاحترافية --- */
    @@media print {
        /* 1. إعدادات الصفحة الأساسية لإلغاء الهوامش البيضاء */
        @@page {
            size: A4 landscape; /* يفضل استخدام الوضع الأفقي لأن الأعمدة كثيرة */
            margin: 10mm;
        }
        /* 2. إخفاء كل ما هو غير ضروري */
        .sidebar, .top-toolbar, .filter-section, .entry-section,
        .no-print, .dataTables_filter, .dataTables_info,
        #sidebar, .btn, .dataTables_length {
            display: none !important;
        }
        /* 3. إجبار الحاوية الرئيسية على التمدد */
        body, .app-wrapper, .main-content, .container-fluid {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background-color: white !important;
        }
        /* 4. إظهار وتوسيع هيدر الطباعة */
        #printHeader {
            display: block !important;
            width: 100% !important;
        }

        .official-print-header {
            width: 100% !important;
            display: flex !important;
            justify-content: space-between !important;
        }
        /* 5. أهم جزء: تمدد الجدول لملء الورقة */
        .card {
            border: none !important;
        }

        .dataTables_wrapper, .dataTables_scroll, .dataTables_scrollHead, .dataTables_scrollBody {
            width: 100% !important;
            overflow: visible !important;
        }

        table#mainTable {
            width: 100% !important;
            margin: 0 !important;
            table-layout: auto !important; /* السماح للمتصفح بتوزيع العرض حسب المحتوى */
            border-collapse: collapse !important;
        }

            table#mainTable th, table#mainTable td {
                border: 1px solid #000 !important;
                padding: 8px 4px !important;
                font-size: 11px !important; /* تكبير الخط قليلاً للوضوح */
                white-space: normal !important; /* السماح للنص بالنزول لسطر جديد إذا كان طويلاً */
            }
            /* تلوين الهيدر في الطباعة */
            table#mainTable thead th {
                background-color: #f1f5f9 !important;
                -webkit-print-color-adjust: exact;
            }
    }
