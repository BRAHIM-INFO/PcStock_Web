            <span class="small fw-bold text-muted">AU:</span><input type="date" id="maxDate" class="form-control form-control-sm">
        </div>
        <div class="ms-auto"><input type="text" id="tableSearch" class="form-control form-control-sm" placeholder="Rechercher..." style="width: 250px;"></div>
    </div>

    <!-- Entry Bar -->
    <div class="entry-section shadow-lg no-print">
        <form id="arrivageForm">
            <div class="row g-2">
                <div class="col-md-2"><label class="label-xl">Date</label><input type="date" name="Dates" id="f_date" class="form-control form-control-xl" value="@DateTime.Now.ToString("yyyy-MM-dd")" required></div>
                <div class="col-md-2"><label class="label-xl">Référence</label><select name="Ref" id="f_ref" class="form-control" required></select></div>
                <div class="col-md-5"><label class="label-xl">Désignation</label><input type="text" name="Designation" id="f_desig" class="form-control form-control-xl border-0" readonly tabindex="-1"></div>
                <div class="col-md-1"><label class="label-xl">Qté</label><input type="number" name="Qte" id="f_qte" class="form-control form-control-xl text-center" step="0.01" required></div>
                <div class="col-md-2"><label class="label-xl">Prix Unit.</label><input type="number" name="Prix" id="f_prix" class="form-control form-control-xl text-end" step="0.01"></div>

                <div class="col-md-2 mt-2"><label class="label-xl">Machine / Engin</label><input type="text" name="Machine" id="f_mach" class="form-control form-control-xl"></div>
                <div class="col-md-3 mt-2"><label class="label-xl">Fournisseur</label><input type="text" name="Fournisseur" id="f_fourn" class="form-control form-control-xl"></div>
                <div class="col-md-2 mt-2"><label class="label-xl">Facture / Bon</label><input type="text" name="Fact_N" id="f_fact" class="form-control form-control-xl"></div>
                <div class="col-md-2 mt-2"><label class="label-xl">BC</label><input type="text" name="Bc_N" id="f_bc" class="form-control form-control-xl"></div>
                <div class="col-md-2 mt-2"><label class="label-xl">Acheteur</label><input type="text" name="Acheteur" id="f_acht" class="form-control form-control-xl"></div>
                <div class="col-md-1 mt-2"><label class="label-xl">Casier</label><input type="text" name="Casier" id="f_cas" class="form-control form-control-xl text-center" readonly tabindex="-1"></div>
                <div class="col-md-2 mt-2 d-flex align-items-end">
                    <button type="submit" id="btnEnregistrer" class="btn btn-primary w-100 fw-bold shadow h-100"><i class="fas fa-save me-2"></i> ENREGISTRER</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table id="mainTable" class="table table-hover align-middle mb-0 w-100">
            <thead class="bg-light">
                <tr>
                    <th>ORD</th>
                    <th>DATE</th>
                    <th>REF</th>
                    <th>DESIGNATION</th>
                    <th>MACHINE</th>
                    <th>QTE</th>
                    <th>PRIX</th>
                    <th>FOURNISSEUR</th>
                    <th>FACT</th>
                    <th>BC</th>
                    <th>ACHETEUR</th>
                    <th>CASIER</th>
                    <th class="no-print">ACTIONS</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal Edit -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white"><h5 class="modal-title fw-bold">Modifier l'arrivage</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form id="editForm">
                <input type="hidden" name="Id" id="e_id">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="small fw-bold">Date</label><input type="date" name="Dates" id="e_date" class="form-control"></div>
                        <div class="col-md-8"><label class="small fw-bold">Désignation</label><input type="text" name="Designation" id="e_desig" class="form-control"></div>
                        <div class="col-md-4"><label class="small fw-bold">Machine</label><input type="text" name="Machine" id="e_mach" class="form-control"></div>
                        <div class="col-md-2"><label class="small fw-bold">Qté</label><input type="number" name="Qte" id="e_qte" class="form-control" step="0.01"></div>
                        <div class="col-md-2"><label class="small fw-bold">Prix</label><input type="number" name="Prix" id="e_prix" class="form-control" step="0.01"></div>
                        <div class="col-md-4"><label class="small fw-bold">Fournisseur</label><input type="text" name="Fournisseur" id="e_fourn" class="form-control"></div>
                        <div class="col-md-4"><label class="small fw-bold">Facture</label><input type="text" name="Fact_N" id="e_fact" class="form-control"></div>
                        <div class="col-md-4"><label class="small fw-bold">Bon Com.</label><input type="text" name="Bc_N" id="e_bc" class="form-control"></div>
                        <div class="col-md-4"><label class="small fw-bold">Acheteur</label><input type="text" name="Acheteur" id="e_acht" class="form-control"></div>
                    </div>
                </div>
                <div class="modal-footer border-0"><button type="submit" class="btn btn-primary px-5 rounded-pill">Enregistrer les modifications</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // 1. فلتر التاريخ
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var min = $('#minDate').val(); var max = $('#maxDate').val();
                if (!min && !max) return true;
                var rowDate = new Date(data[1].split('/').reverse().join('-'));
                var dStart = min ? new Date(min) : null; var dEnd = max ? new Date(max) : null;
                return (!dStart || rowDate >= dStart) && (!dEnd || rowDate <= dEnd);
            });

            const table = $('#mainTable').DataTable({
                ajax: { url: "?handler=LoadData", dataSrc: "" },
                paging: false, scrollY: "450px", scroller: true, dom: 'Brt',
                buttons: [{ extend: 'excelHtml5', className: 'd-none', exportOptions: { columns: ':visible' } }],
                columns: [
                    { data: "ord" },
                    { data: "dates", render: d => d ? new Date(d).toLocaleDateString('fr-FR') : '' },
                    { data: "ref_art", className: "fw-bold text-primary" },
                    { data: "designation" },
                    { data: "machine" },
                    { data: "qte", className: "text-center fw-bold text-success" },
                    { data: "prix", render: d => parseFloat(d || 0).toLocaleString('fr-FR') },
                    { data: "fournisseur" },
                    { data: "fact_n" },
                    { data: "bc_n" },
                    { data: "acheteur" },
                    { data: "casier", className: "text-warning fw-bold" },
                    {
                        data: null, className: "no-print",
                        render: d => `<div class="action-buttons">
                            <div class="btn-table btn-edit-s" onclick='openEdit(${JSON.stringify(d)})'><i class="fas fa-pen"></i></div>
                            <div class="btn-table btn-delete-s" onclick="deleteRow(${d.id})"><i class="fas fa-trash"></i></div>
                        </div>`
                    }
                ]
            });

            $('#tableSearch').on('keyup', function () { table.search(this.value).draw(); });
            $('#minDate, #maxDate').on('change', () => table.draw());
            $('#btnExcel').click(() => table.button('.buttons-excel').trigger());

            $('#f_ref').select2({
                ajax: { url: '?handler=ArticleAutocomplete', delay: 250, data: p => ({ term: p.term }), processResults: d => ({ results: d.results }) },
                placeholder: "Saisir REF...", minimumInputLength: 1, width: '100%'
            });

            $('#f_ref').on('select2:select', function (e) {
                $('#f_desig').val(e.params.data.intitule);
                $('#f_cas').val(e.params.data.casier);
                setTimeout(() => $('#f_qte').focus().select(), 100);
            });

            // زر الحفظ (AJOUTER/ENREGISTRER)
            $('#arrivageForm').on('submit', function (e) {
                e.preventDefault();
                const $btn = $('#btnEnregistrer');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.ajax({
                    url: '?handler=Save',
                    type: 'POST',
                    data: $(this).serialize(),
                    headers: { "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val() },
                    success: function (r) {
                        if (r.success) {
                            table.ajax.reload();
                            $('#f_ref').val(null).trigger('change');
                            $('#arrivageForm')[0].reset();
                            $('#f_date').val(new Date().toISOString().split('T')[0]);
                            const T = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 });
                            T.fire({ icon: 'success', title: 'Enregistré' });
                        }
                    },
                    complete: () => $btn.prop('disabled', false).html('<i class="fas fa-save me-2"></i> ENREGISTRER')
                });
            });

            // حفظ التعديل (UPDATE)
            $('#editForm').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '?handler=Update',
                    type: 'POST',
                    data: $(this).serialize(),
                    headers: { "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val() },
                    success: function (r) {
                        if (r.success) { $('#editModal').modal('hide'); table.ajax.reload(); Swal.fire('Succès', 'Mis à jour !', 'success'); }
                    }
                });
            });
        });

        function openEdit(d) {
            $('#e_id').val(d.id);
            $('#e_date').val(d.dates);
            $('#e_desig').val(d.designation);
            $('#e_mach').val(d.machine);
            $('#e_qte').val(d.qte);
            $('#e_prix').val(d.prix);
            $('#e_fourn').val(d.fournisseur);
            $('#e_fact').val(d.fact_n);
            $('#e_bc').val(d.bc_n);
            $('#e_acht').val(d.acheteur);
            $('#editModal').modal('show');
        }

        function deleteRow(id) {
            Swal.fire({ title: 'Supprimer ?', icon: 'warning', showCancelButton: true }).then((res) => {
                if (res.isConfirmed) $.ajax({
                    url: '?handler=Delete', type: 'POST', data: { id: id },
                    headers: { "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val() },
                    success: () => table.ajax.reload()
                });
            });
        }
    </script>
} *@