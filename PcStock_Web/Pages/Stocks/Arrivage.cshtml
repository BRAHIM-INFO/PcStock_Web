@page
@model PcStock_Web.Pages.Stocks.ArrivageModel
@{
    ViewData["Title"] = "Arrivage Journalier";
}

<div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 shadow-sm">
    <h4 class="fw-bold mb-0">Arrivage Journalier</h4>
    <div>
        <button class="btn btn-success me-2"><i class="fas fa-file-excel me-2"></i>Exporter Excel</button>
        <button class="btn btn-dark"><i class="fas fa-print me-2"></i>Imprimer Liste</button>
    </div>
</div>

<div class="container-fluid">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-secondary fw-bold"><i class="fas fa-plus me-2"></i>NOUVELLE ENTRÉE</h6>
        </div>
        <div class="card-body">
            <form method="post" class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="form-control bg-light" placeholder="AUTO (Next: 1)" readonly>
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="REF">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="DESIGNATION">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="MACHINE">
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control" placeholder="QTE">
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control" placeholder="PRIX">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="FOURNISSEUR">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="FACT N°">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="B N°">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="CASIER">
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="ACHETTEUR">
                </div>
                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        <i class="fas fa-save me-2"></i>Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
                <input type="text" class="form-control w-25" placeholder="Rechercher...">
                <div class="d-flex align-items-center">
                    <span class="me-2 small">DU:</span><input type="date" class="form-control form-control-sm me-3">
                    <span class="me-2 small">AU:</span><input type="date" class="form-control form-control-sm">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle border-top">
                    <thead class="bg-light small">
                        <tr>
                            <th>ORD</th>
                            <th>DATE</th>
                            <th>REF</th>
                            <th>DESIGNATION</th>
                            <th>MACHINE</th>
                            <th>QTE</th>
                            <th>PRIX</th>
                            <th>FOURNISSEUR</th>
                            <th>FACT N°</th>
                            <th>B N°</th>
                            <th>CASIER</th>
                            <th>ACHETTEUR</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">Aucune donnée trouvée</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>