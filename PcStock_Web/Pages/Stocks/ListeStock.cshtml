@page
@model PcStock_Web.Pages.Stocks.ListeStockModel
@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/scroller/2.2.0/css/scroller.dataTables.min.css">
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    /* تنسيق فلتر الإكسل */
    .filter-trigger { cursor: pointer; color: #94a3b8; font-size: 10px; margin-left: 5px; }
    .filter-trigger.active { color: #2563eb; }
    .excel-filter-menu { display: none; position: absolute; background: white; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 10px 15px rgba(0,0,0,0.1); z-index: 9999; width: 230px; padding: 12px; }
    .filter-search { width: 100%; padding: 6px; font-size: 12px; border: 1px solid #e2e8f0; border-radius: 5px; margin-bottom: 10px; }
    .filter-list { max-height: 180px; overflow-y: auto; margin-bottom: 10px; list-style: none; padding: 0; }
    .filter-item { font-size: 12px; padding: 4px 0; display: flex; align-items: center; }
    .filter-item input { margin-right: 8px; }

    /* شاشة الإجمالي LCD */
    .lcd-screen { background: #050505; border: 4px solid #334155; border-radius: 12px; padding: 10px 30px; display: inline-flex; align-items: center; box-shadow: 0 10px 20px rgba(0,0,0,0.3); }
    #txtGrandTotal { color: #00ff41; font-family: 'Digital-7 Mono', sans-serif; font-size: 60px; text-shadow: 0 0 10px #00ff41; }
    .lcd-unit { color: #00ff41; font-family: 'Digital-7 Mono', sans-serif; font-size: 25px; margin-left: 10px; opacity: 0.8; }

    table.dataTable thead th { background: #f8fafc; padding: 12px 8px; font-size: 13px; border-bottom: 2px solid #dee2e6; }
</style>

<div class="container-fluid p-4">
  @*   <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
        <h4 class="fw-bold mb-0 text-primary"><i class="fas fa-boxes me-2"></i> LISTE DES STOCKS</h4>
        <button class="btn btn-light border text-primary fw-bold" onclick="window.print()"><i class="fas fa-print me-2"></i>Imprimer</button>
    </div> *@
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
        <h4 class="fw-bold mb-0 text-primary"><i class="fas fa-boxes me-2"></i> LISTE DES STOCKS</h4>

        <div class="d-flex gap-3 align-items-center">
            <!-- حقل البحث العام الجديد -->
            <div class="input-group shadow-sm" style="width: 350px;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" id="globalSearch" class="form-control border-start-0 ps-0 shadow-none"
                       placeholder="Rechercher (REF, Désignation, Famille...)">
            </div>

            <button class="btn btn-light border text-primary fw-bold" onclick="window.print()">
                <i class="fas fa-print me-2"></i>Imprimer
            </button>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table id="stockTable" class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>REF</th><th>INTITULE</th><th>INTITULE2</th><th>INTITULE3</th><th>FAMILLE</th>
                    <th>QTE</th><th>PAMP</th><th>MONTANT</th><th>STOCK_INI</th><th>CASIER</th><th>DATE_MAJ</th><th>EDIT</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="text-end mt-4">
        <span class="fw-bold text-muted me-3">TOTAL GÉNÉRAL HT (FILTRÉ)</span>
        <div class="lcd-screen shadow-lg">
            <span id="txtGrandTotal">0,00</span>
            <span class="lcd-unit">DA</span>
        </div>
    </div>
</div>

@* ... (كود الـ Modal الخاص بالتعديل من الرسائل السابقة - كما هو بدون تغيير) ... *@
<!-- Modal de Modification -->
<div class="modal fade" id="editArticleModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <!-- Header -->
            <div class="modal-header bg-primary text-white border-0" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold" id="editModalLabel">
                    <i class="fas fa-edit me-2"></i> Modification de l'Article : <span id="displayRef" class="badge bg-white text-primary"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="editForm">
                <div class="modal-body p-4 bg-light">
                    <!-- Nav Tabs -->
                    <ul class="nav nav-pills mb-4 justify-content-center" id="pills-tab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active px-4" id="tab-info-tab" data-bs-toggle="pill" data-bs-target="#tab-info" type="button" role="tab"><i class="fas fa-info-circle me-2"></i>Identification</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link px-4" id="tab-stock-tab" data-bs-toggle="pill" data-bs-target="#tab-stock" type="button" role="tab"><i class="fas fa-boxes me-2"></i>Stock & Prix</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link px-4" id="tab-stats-tab" data-bs-toggle="pill" data-bs-target="#tab-stats" type="button" role="tab"><i class="fas fa-chart-line me-2"></i>Statistiques</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="pills-tabContent">
                        <!-- Tab 1: Identification -->
                        <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">Référence (Non modifiable)</label>
                                    <input type="text" id="editREF" name="REF" class="form-control bg-white fw-bold" readonly>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold text-muted">Intitulé Principal</label>
                                    <input type="text" id="editINTITULE" name="INTITULE" class="form-control border-primary shadow-sm">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Intitulé 2</label>
                                    <input type="text" id="editINTITULE2" name="INTITULE2" class="form-control">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">Intitulé 3</label>
                                    <input type="text" id="editINTITULE3" name="INTITULE3" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">Famille</label>
                                    <input type="text" id="editFAMILLE" name="FAMILLE" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">Lieu de Stockage</label>
                                    <input type="text" id="editLIEU_STO" name="LIEU_STO" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">Casier</label>
                                    <input type="text" id="editCASIER" name="CASIER" class="form-control border-warning shadow-sm">
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Stock & Prix -->
                        <div class="tab-pane fade" id="tab-stock" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-success">
                                        <label class="small fw-bold text-success">Quantité Actuelle</label>
                                        <input type="number" id="editQTE" name="QTE" class="form-control form-control-lg border-0 bg-transparent fw-bold" step="0.01" readonly>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-primary">
                                        <label class="small fw-bold text-primary">PAMP</label>
                                        <input type="number" id="editPAMP" name="PAMP" class="form-control form-control-lg border-0 bg-transparent fw-bold" step="0.01" readonly>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-muted">Prix Achat</label>
                                    <input type="number" id="editPRIX_ACH" name="PRIX_ACH" class="form-control" step="0.01" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-muted">Valeur Initiale</label>
                                    <input type="number" id="editVALEUR_INI" name="VALEUR_INI" class="form-control" step="0.01" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-muted">Stock Initial</label>
                                    <input type="number" id="editSTOCK_INI" name="STOCK_INI" class="form-control" step="0.01" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-danger">Stock Max</label>
                                    <input type="number" id="editSTOCK_MAX" name="STOCK_MAX" class="form-control border-danger shadow-sm" step="0.01" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-warning">Stock Sécurité</label>
                                    <input type="number" id="editSTOCK_SEC" name="STOCK_SEC" class="form-control border-warning shadow-sm" step="0.01" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label class="small fw-bold text-muted">Dernière MAJ</label>
                                    <input type="date" id="editDATE_MAJ" name="DATE_MAJ" class="form-control" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Statistiques (Read-only cards) -->
                        <div class="tab-pane fade" id="tab-stats" role="tabpanel">
                            <div class="row g-3">
                                <!-- المجموعة الأولى: عدد الحركات -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                                        <label class="text-muted small fw-bold mb-2"><i class="fas fa-exchange-alt me-1"></i> Total Mouvements (Nombre)</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text bg-success-subtle text-success border-0 small">Entrées</span>
                                            <input type="text" id="editENTREES" class="form-control bg-light border-0 text-center fw-bold text-success" readonly tabindex="-1">
                                        </div>
                                        <div class="input-group">
                                            <span class="input-group-text bg-danger-subtle text-danger border-0 small">Sorties</span>
                                            <input type="text" id="editSORTIES" class="form-control bg-light border-0 text-center fw-bold text-danger" readonly tabindex="-1">
                                        </div>
                                    </div>
                                </div>

                                <!-- المجموعة الثانية: الكميات الإجمالية -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                                        <label class="text-muted small fw-bold mb-2"><i class="fas fa-boxes me-1"></i> Quantités Cumulées</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text bg-info-subtle text-info border-0 small">Qte Ent.</span>
                                            <input type="text" id="editQTE_ENT" class="form-control bg-light border-0 text-center fw-bold text-info" readonly tabindex="-1">
                                        </div>
                                        <div class="input-group">
                                            <span class="input-group-text bg-warning-subtle text-warning border-0 small">Qte Sor.</span>
                                            <input type="text" id="editQTE_SOR" class="form-control bg-light border-0 text-center fw-bold text-warning" readonly tabindex="-1">
                                        </div>
                                    </div>
                                </div>

                                <!-- المجموعة الثالثة: القيمة المتبقية -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm p-3 rounded-4 bg-primary text-white h-100 justify-content-center">
                                        <label class="small fw-bold mb-2 opacity-75"><i class="fas fa-wallet me-1"></i> Valeur Résiduelle (TEMPVAL)</label>
                                        <div class="input-group">
                                            <input type="text" id="editTEMPVAL" class="form-control form-control-lg bg-white border-0 text-center fw-bold text-primary shadow-sm" readonly tabindex="-1">
                                            <span class="input-group-text bg-white border-0 text-primary fw-bold">DA</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- السطر الثاني: المبالغ المالية HT -->
                                <div class="col-12 mt-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <div class="p-2 bg-white rounded-3 shadow-sm border-bottom border-primary border-3">
                                                <label class="d-block small text-muted mb-1">Achat HT</label>
                                                <input type="text" id="editACHAT_HT" class="form-control form-control-sm border-0 bg-light text-primary fw-bold text-center" readonly tabindex="-1">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="p-2 bg-white rounded-3 shadow-sm border-bottom border-success border-3">
                                                <label class="d-block small text-muted mb-1">Conso HT</label>
                                                <input type="text" id="editCONSO_HT" class="form-control form-control-sm border-0 bg-light text-success fw-bold text-center" readonly tabindex="-1">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="p-2 bg-white rounded-3 shadow-sm border-bottom border-info border-3">
                                                <label class="d-block small text-muted mb-1">Cession HT</label>
                                                <input type="text" id="editCESS_HT" class="form-control form-control-sm border-0 bg-light text-info fw-bold text-center" readonly tabindex="-1">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="p-2 bg-white rounded-3 shadow-sm border-bottom border-warning border-3">
                                                <label class="d-block small text-muted mb-1">Reinté. HT</label>
                                                <input type="text" id="editCESSR_HT" class="form-control form-control-sm border-0 bg-light text-warning fw-bold text-center" readonly tabindex="-1">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <!-- يجب أن يكون النوع submit وليس button -->
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-2"></i> Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/scroller/2.2.0/js/dataTables.scroller.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let table;

        $(document).ready(function () {
            // إضافة أيقونات الفلتر
            $('#stockTable thead th').each(function (i) {
                if (i !== 11 && i !== 7) $(this).append('<i class="fas fa-filter filter-trigger" data-col="'+i+'"></i>');
            });

            table = $('#stockTable').DataTable({
                serverSide: true, processing: true, scrollX: true, scrollY: 550, scroller: true, dom: 'lrtip',
                ajax: {
                    url: "?handler=LoadData", type: "POST",
                    headers: { "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val() }
                },
                columns: [
                    { data: "ref" }, { data: "intitule" }, { data: "intitule2" }, { data: "intitule3" }, { data: "famille" },
                    { data: "qte", className: "text-end", render: d => parseFloat(d).toLocaleString('en-US', {minimumFractionDigits: 2}) },
                    { data: "pamp", className: "text-end", render: d => parseFloat(d).toLocaleString('en-US', {minimumFractionDigits: 2}) },
                    { data: null, className: "text-end fw-bold", render: (d,t,row) => (row.qte * row.pamp).toLocaleString('en-US', {minimumFractionDigits: 2}) },
                    { data: "stock_ini", className: "text-end", render: d => parseFloat(d).toLocaleString('en-US', {minimumFractionDigits: 2}) },
                    { data: "casier" }, { data: "date_maj" },
                    { data: null, orderable: false, render: d => `<button class="btn btn-primary btn-sm" onclick="prepareEdit('${d.ref}')"><i class="fas fa-edit"></i></button>` }
                ],
                drawCallback: function(settings) {
                    $('#txtGrandTotal').text(parseFloat(settings.json.filterSum || 0).toLocaleString('en-US', {minimumFractionDigits: 2}));
                }
            });

            // نافذة فلتر الإكسل
            $('body').append('<div id="filterPopup" class="excel-filter-menu"><input type="text" class="filter-search" placeholder="Rechercher..."><div class="filter-list" id="itemsArea"></div><div class="d-flex justify-content-between mt-2 border-top pt-2"><button class="btn btn-sm btn-light" id="btnCancel">Annuler</button><button class="btn btn-sm btn-primary" id="btnApply">Filtrer</button></div></div>');

            let currentCol = -1;
            $('.filter-trigger').click(function (e) {
                e.stopPropagation(); currentCol = $(this).data('col');
                let rect = this.getBoundingClientRect();
                $('#itemsArea').html('<div class="text-center small py-3">Chargement...</div>');
                $('#filterPopup').css({ top: rect.bottom + window.scrollY, left: rect.left - 150 }).fadeIn(100);
                
                let colName = table.settings().init().columns[currentCol].data;
                $.get('?handler=UniqueValues&columnName=' + colName.toUpperCase(), function (values) {
                    let html = '<div class="filter-item"><label><input type="checkbox" id="checkAll"> (Tout)</label></div>';
                    values.forEach(v => html += `<div class="filter-item"><label><input type="checkbox" class="opt-check" value="${v}"> ${v}</label></div>`);
                    $('#itemsArea').html(html);
                });
            });

            $(document).on('click', '#btnApply', function () {
                let selected = []; $('.opt-check:checked').each(function () { selected.push($(this).val()); });
                let searchStr = selected.map(s => $.fn.dataTable.util.escapeRegex(s)).join('|');
                table.column(currentCol).search(searchStr ? '^(' + searchStr + ')$' : '', true, false).draw();
                $(`.filter-trigger[data-col="${currentCol}"]`).toggleClass('active', selected.length > 0);
                $('#filterPopup').fadeOut(100);
            });

            $('.filter-search').on('keyup', function() {
                let v = $(this).val().toLowerCase();
                $('.filter-item').filter(function() { $(this).toggle($(this).text().toLowerCase().indexOf(v) > -1); });
            });
            $('#btnCancel').click(() => $('#filterPopup').fadeOut(100));
            $(document).click(e => { if (!$(e.target).closest('#filterPopup').length) $('#filterPopup').fadeOut(100); });

                // ربط حقل البحث العام بالجدول
            $('#globalSearch').on('keyup', function () {
            table.search(this.value).draw();
        });
        });
        
        // دالة التعديل كما في الرسائل السابقة
          function prepareEdit(ref) {
            var table = $('#stockTable').DataTable();
            // البحث عن السطر في ذاكرة الجدول
            var rowData = table.rows().data().toArray().find(x => x.ref === ref);

                 if (rowData) {
            // --- 1. ملء بيانات التبويب الأول (Identification) ---
            $('#displayRef').text(rowData.ref);
            $('#editREF').val(rowData.ref);
            $('#editINTITULE').val(rowData.intitule);
            $('#editINTITULE2').val(rowData.intitule2 || "");
            $('#editINTITULE3').val(rowData.intitule3 || "");
            $('#editFAMILLE').val(rowData.famille || "");
            $('#editLIEU_STO').val(rowData.lieU_STO || "");
            $('#editCASIER').val(rowData.casier || "");

            // --- 2. ملء بيانات التبويب الثاني (Stock & Prix) ---
            $('#editQTE').val(rowData.qte);
            $('#editPAMP').val(rowData.pamp);
            $('#editPRIX_ACH').val(rowData.priX_ACH || rowData.prixAch || 0);
            $('#editSTOCK_INI').val(rowData.stocK_INI || rowData.stockIni || 0);
            $('#editVALEUR_INI').val(rowData.valeuR_INI || rowData.valeurIni || 0);
            $('#editSTOCK_MAX').val(rowData.stocK_MAX || rowData.stockMax || 0);
            $('#editSTOCK_SEC').val(rowData.stocK_SEC || rowData.stockSec || 0);

            // تنسيق التاريخ ليعمل مع حقل input type="date"
            if (rowData.datE_MAJ || rowData.dateMaj) {
                let dateVal = rowData.datE_MAJ || rowData.dateMaj;
                $('#editDATE_MAJ').val(new Date(dateVal).toISOString().split('T')[0]);
            }

            // --- 3. ملء بيانات التبويب الثالث (Statistiques) ---
            // دالة مساعدة لتنسيق الأرقام
            const formatNum = (num) => parseFloat(num || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 });

            // تفعيل الأسطر التي كانت معطلة مع تصحيح اسم الكائن إلى rowData
            $('#editENTREES').val(rowData.entrees || 0);
            $('#editSORTIES').val(rowData.sorties || 0);

            $('#editQTE_ENT').val(formatNum(rowData.qtE_ENT || rowData.qteEnt));
            $('#editQTE_SOR').val(formatNum(rowData.qtE_SOR || rowData.qteSor));
            $('#editTEMPVAL').val(formatNum(rowData.tempval) + " DA");

            $('#editACHAT_HT').val(formatNum(rowData.achaT_HT || rowData.achatHt));
            $('#editCONSO_HT').val(formatNum(rowData.consO_HT || rowData.consoHt));
            $('#editCESS_HT').val(formatNum(rowData.cesS_HT || rowData.cessHt));
            $('#editCESSR_HT').val(formatNum(rowData.cessR_HT || rowData.cessrHt));

            // فتح النافذة
            $('#editArticleModal').modal('show');
        }
        }
        // function prepareEdit(ref) {
        //     let row = table.rows().data().toArray().find(x => x.ref === ref);
        //     if(row) {
        //         $('#displayRef').text(row.ref);
        //         $('#editREF').val(row.ref);
        //         $('#editINTITULE').val(row.intitule);
        //         // ... بقية حقول المودال ...
        //         $('#editArticleModal').modal('show');
        //     }
        // }
    </script>
}