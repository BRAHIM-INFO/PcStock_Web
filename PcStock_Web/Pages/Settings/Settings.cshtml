@page
@model PcStock_Web.Pages.Settings.SettingsModel
@{
    ViewData["Title"] = "Settings";
}
<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Paramètres du Système</h2>
            <p class="text-muted">Configuration des chemins de données et de l'identité visuelle</p>
        </div>
        <button type="submit" form="settingsForm" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px; background-color: #2563eb;">
            <i class="fas fa-save me-2"></i> Enregistrer les modifications
        </button>
    </div>

    <form id="settingsForm" asp-controller="Settings" asp-action="SaveSettings" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Card 1: Base de Données -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box me-3 text-primary fs-3">
                            <i class="fas fa-database text-blue-custom"></i>
                        </div>
                        <h5 class="mb-0 fw-bold" style="color: #1e40af;">Base de Données (DBF)</h5>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Répertoire de PCSTOCK</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-warning">
                                <i class="fas fa-folder"></i>
                            </span>
                            <input type="text" id="dbPath" name="DbPath" class="form-control border-start-0 bg-light" placeholder="C:\PCSTOCK\2026" value="C:\PCSTOCK\2026">
                            <button class="btn btn-dark px-4" type="button" id="btnBrowse">
                                <i class="fas fa-search me-2"></i> Parcourir
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 d-flex justify-content-between align-items-center mt-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0 !important; border-radius: 12px;">
                        <div class="small text-muted">
                            <i class="fas fa-info-circle me-2"></i> Cliquez pour vérifier la validité du répertoire et des fichiers .DBF
                        </div>
                        <button type="button" id="btnTestConnection" class="btn btn-outline-info btn-sm rounded-pill px-3">
                            <i class="fas fa-vial me-1"></i> Test Connection
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card 2: Logo -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box me-3 text-warning fs-3">
                            <i class="fas fa-palette"></i>
                        </div>
                        <h5 class="mb-0 fw-bold">Logo de l'Entreprise</h5>
                    </div>

                    <div class="text-center mb-4 position-relative">
                        <div class="logo-preview-container mx-auto position-relative" style="width: 150px; height: 150px;">
                            <img id="imgPreview" src="/images/default-avatar.png" class="rounded-circle border border-4 border-white shadow shadow-sm w-100 h-100 object-fit-cover" alt="Logo">
                            <span class="badge bg-success position-absolute bottom-0 start-50 translate-middle-x mb-2 shadow">
                                <i class="fas fa-eye me-1"></i> Aperçu
                            </span>
                        </div>
                    </div>

                    <div class="upload-zone border-dashed p-3 text-center" style="border: 2px dashed #e2e8f0; border-radius: 10px;">
                        <div class="input-group input-group-sm">
                            <input type="file" class="form-control" id="logoUpload" name="LogoFile" accept="image/*">
                        </div>
                        <p class="text-muted small mt-2 mb-0">Format supporté: PNG, JPG (Max 2MB)</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div> 
@section Scripts {
    <!-- 1. استدعاء المكتبات أولاً -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- 2. استدعاء ملفك الخاص -->
    <script src="~/js/settings.js"></script>

    <!-- 3. كود رسالة النجاح بعد الحفظ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                title: 'Succès !',
                text: '@TempData["SuccessMessage"]',
                icon: 'success'
            });
        </script>
    }
}