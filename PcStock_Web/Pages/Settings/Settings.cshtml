@page
@model PcStock_Web.Pages.Settings.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Paramètres du Système</h2>
            <p class="text-muted">Configuration des chemins de données et de l'identité visuelle</p>
        </div>
        <button type="submit" form="settingsForm" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px; background-color: #2563eb;">
            <i class="fas fa-save me-2"></i> Enregistrer les modifications
        </button>
    </div>

    <form id="settingsForm" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Card 1: Base de Données -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box me-3 text-primary fs-3">
                            <i class="fas fa-database" style="color: #2563eb;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold" style="color: #1e40af;">Base de Données (DBF)</h5>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Répertoire de PCSTOCK</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-warning">
                                <i class="fas fa-folder"></i>
                            </span>
                            <input type="text" asp-for="DbPath" id="dbPath" class="form-control border-start-0 bg-light" placeholder="C:\PCSTOCK\2026">
                            <button class="btn btn-dark px-4" type="button" id="btnBrowse">
                                <i class="fas fa-search me-2"></i> Parcourir
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 d-flex justify-content-between align-items-center mt-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0 !important; border-radius: 12px;">
                        <div class="small text-muted">
                            <i class="fas fa-info-circle me-2"></i> Cliquez لعمل مزامنة يدوية والتأكد من الملفات
                        </div>
                        <button type="button" id="btnTestConnection" class="btn btn-outline-info btn-sm rounded-pill px-3">
                            <i class="fas fa-vial me-1"></i> Test & Sync
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card 2: Logo (تم التعديل ليكون مستطيلاً) -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box me-3 text-warning fs-3">
                            <i class="fas fa-palette"></i>
                        </div>
                        <h5 class="mb-0 fw-bold">Logo de l'Entreprise</h5>
                    </div>

                    <div class="text-center mb-4">
                        <!-- تم تغيير الأبعاد هنا (عرض 100% بارتفاع 120px) ليكون مستطيلاً -->
                        <div class="logo-preview-container mx-auto position-relative shadow-sm border border-2 border-white rounded" style="width: 100%; max-width: 320px; height: 130px; background-color: #fcfcfc; overflow: hidden;">
                            <!-- تم حذف rounded-circle واستخدام object-fit-contain لإظهار اللوجو كاملاً بدون قص -->
                            <img id="imgPreview" src="/images/logo_entreprise.png" onerror="this.src='/images/default-avatar.png'" 
                                 class="w-100 h-100 p-2" style="object-fit: contain;">
                            
                            <span class="badge bg-success position-absolute bottom-0 start-50 translate-middle-x mb-2 shadow">
                                <i class="fas fa-eye me-1"></i> Aperçu
                            </span>
                        </div>
                    </div>

                    <div class="upload-zone border-dashed p-3 text-center" style="border: 2px dashed #e2e8f0; border-radius: 10px;">
                        <input type="file" class="form-control shadow-none" asp-for="LogoFile" id="logoUpload" accept="image/*">
                        <p class="text-muted small mt-2 mb-0 text-uppercase fw-bold" style="font-size: 10px;">Format supporté: PNG, JPG (Max 2MB)</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/settings.js"></script>

    <script>
        $(document).ready(function () {
            // معالجة معاينة الصورة فور اختيارها
            $('#logoUpload').change(function (e) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(this.files[0]);
            });

            // عند الضغط على زر الحفظ (إظهار مؤشر التحميل)
            $('#settingsForm').on('submit', function () {
                Swal.fire({
                    title: 'Synchronisation...',
                    text: 'Veuillez patienter pendant la mise à jour des données SQLite.',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            });
        });
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({ title: 'Succès !', text: '@TempData["SuccessMessage"]', icon: 'success', confirmButtonColor: '#2563eb' });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({ title: 'Erreur', text: '@TempData["ErrorMessage"]', icon: 'error', confirmButtonColor: '#d33' });
        </script>
    }
}
