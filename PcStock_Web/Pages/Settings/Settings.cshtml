@page
@model PcStock_Web.Pages.Settings.SettingsModel
@{
    ViewData["Title"] = "Configurations";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Paramètres du Système</h2>
            <p class="text-muted">Gérez la connexion aux données et les informations de l'entreprise</p>
        </div>
        <button type="submit" form="settingsForm" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px; background-color: #2043B3;">
            <i class="fas fa-save me-2"></i> Enregistrer les modifications
        </button>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-pills mb-4 shadow-sm bg-white p-2 rounded-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="pills-db-tab" data-bs-toggle="pill" data-bs-target="#pills-db" type="button" role="tab">
                <i class="fas fa-database me-2"></i> Base de Données & Logo
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pills-info-tab" data-bs-toggle="pill" data-bs-target="#pills-info" type="button" role="tab">
                <i class="fas fa-building me-2"></i> Coordonnées de l'entreprise
            </button>
        </li>
    </ul>

    <form id="settingsForm" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="tab-content" id="pills-tabContent">

            <!-- Tab 1: Base de Données & Logo -->
            <div class="tab-pane fade show active" id="pills-db" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                            <h5 class="mb-4 fw-bold text-primary"><i class="fas fa-folder-open me-2"></i>Répertoire PCSTOCK</h5>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">Chemin des fichiers DBF</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-warning"><i class="fas fa-folder"></i></span>
                                    <input type="text" asp-for="DbPath" id="dbPath" class="form-control border-start-0 bg-light">
                                    <button class="btn btn-dark px-4" type="button" id="btnBrowse">Parcourir</button>
                                </div>
                            </div>
                            <div class="alert alert-info border-0 d-flex justify-content-between align-items-center mt-4" style="border-radius: 12px;">
                                <div class="small text-muted"><i class="fas fa-sync me-2"></i> Cliquez pour synchroniser les données SQLite</div>
                                <button type="button" id="btnTestConnection" class="btn btn-outline-info btn-sm rounded-pill px-3">Test & Sync</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 15px;">
                            <h5 class="mb-4 fw-bold text-primary"><i class="fas fa-palette me-2"></i>Logo de l'Entreprise</h5>
                            <div class="text-center mb-4">
                                <div class="logo-preview-container mx-auto position-relative shadow-sm border border-2 border-white rounded" style="width: 100%; max-width: 320px; height: 130px; background-color: #fcfcfc;">
                                    <img id="imgPreview" src="/images/logo_entreprise.png" onerror="this.src='/images/default-avatar.png'" class="w-100 h-100 p-2" style="object-fit: contain;">
                                </div>
                            </div>
                            <input type="file" class="form-control" asp-for="LogoFile" id="logoUpload" accept="image/*">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: بيانات الشركة (كما في الصورة) -->
            <div class="tab-pane fade" id="pills-info" role="tabpanel">
                <div class="card border-0 shadow-sm p-4 mx-auto" style="border-radius: 15px; max-width: 900px;">
                    <h5 class="mb-4 fw-bold text-primary border-bottom pb-2">Informations de l'Unité / Direction</h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">DIRECTION / UNITÉ</label>
                            <input type="text" asp-for="Direction" class="form-control fw-bold shadow-sm" placeholder="Ex: DIRECTION CENTRALE DU MATÉRIEL">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">DÉPARTEMENT</label>
                            <input type="text" asp-for="Departement" class="form-control" placeholder="Ex: DÉPARTEMENT APPROVISIONNEMENTS">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">SERVICE</label>
                            <input type="text" asp-for="Service" class="form-control" placeholder="Ex: SERVICE GESTION DES STOCKS">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">ADRESSE</label>
                            <input type="text" asp-for="Adresse" class="form-control" placeholder="Ex: DRAA EL HADJA - M'SILA">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">E-MAIL PROFESSIONNEL</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" asp-for="Email" class="form-control" placeholder="cosidertp.dcm.appro@gmail.com">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/settings.js"></script>

    <script>
        $(document).ready(function () {
            // مؤشر الانتظار عند الضغط على حفظ
            $('#settingsForm').on('submit', function () {
                Swal.fire({
                    title: 'Synchronisation...',
                    text: 'Veuillez patienter...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });
            });

            // إظهار رسالة النجاح القادمة من السيرفر
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Succès !',
                    text: '@TempData["SuccessMessage"]',
                    icon: 'success',
                    confirmButtonColor: '#2043B3'
                });
                </text>
            }

            // إظهار رسالة الخطأ إذا وجدت
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Erreur',
                    text: '@TempData["ErrorMessage"]',
                    icon: 'error',
                    confirmButtonColor: '#d33'
                });
                </text>
            }
        });
    </script>
}
