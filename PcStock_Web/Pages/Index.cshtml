@page
@model IndexModel
@{
    ViewData["Title"] = "Tableau de Bord";
}

<div class="dashboard-header-bg">
    <div class="container-fluid d-flex justify-content-between align-items-center h-100 px-4">
        <div class="header-info d-flex align-items-center">
            <div class="header-icon-box me-3">
                <i class="fas fa-th-large text-primary fs-4"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1">COSIDER TP - Tableau de Bord</h4>
                <p class="mb-0 small opacity-75">
                    Suivi en temps réel de l'état du stock importé depuis ST_STOCK. Unité de mesure monétaire: <strong>Dinar Algérien (DA)</strong>.
                </p>
            </div>
        </div>
        <div class="header-status d-flex align-items-center">
            <div class="status-badge me-3">
                <i class="fas fa-chart-line me-2"></i>Système Actif
            </div>
            <div class="current-date small">@DateTime.Now.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</div>
        </div>
    </div>
</div>

<div class="stats-container px-4">
    <div class="row g-3">
        <div class="col">
            <div class="stat-card border-blue">
                <div class="stat-header">
                    <span class="stat-label blue-text">STOCK TOTAL</span>
                    <i class="fas fa-cubes stat-bg-icon"></i>
                </div>
                <h3 class="stat-value">992 292 409,53 DA</h3>
            </div>
        </div>

        <div class="col">
            <div class="stat-card border-green">
                <div class="stat-header">
                    <span class="stat-label green-text">ACHATS</span>
                    <i class="fas fa-shopping-cart stat-bg-icon"></i>
                </div>
                <h3 class="stat-value">1 246 385 180,80 DA</h3>
            </div>
        </div>

        <div class="col">
            <div class="stat-card border-orange">
                <div class="stat-header">
                    <span class="stat-label orange-text">CESS. FOURNIE</span>
                    <i class="fas fa-external-link-alt stat-bg-icon"></i>
                </div>
                <h3 class="stat-value">891 435 731,02 DA</h3>
            </div>
        </div>

        <div class="col">
            <div class="stat-card border-red">
                <div class="stat-header">
                    <span class="stat-label red-text">CONSOS</span>
                    <i class="fas fa-clipboard-list stat-bg-icon"></i>
                </div>
                <h3 class="stat-value">207 898 686,25 DA</h3>
            </div>
        </div>

        <div class="col">
            <div class="stat-card border-cyan">
                <div class="stat-header">
                    <span class="stat-label cyan-text">CESS. REÇUE</span>
                    <i class="fas fa-level-down-alt stat-bg-icon"></i>
                </div>
                <h3 class="stat-value">23 713 180,33 DA</h3>
            </div>
        </div>
    </div>
</div>