@page
@model PcStock_Web.Pages.Achats.RECAP_ACHATS_MENSUELModel
@{
    ViewData["Title"] = "Recap Mensuel par Famille";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .page-header {
        background: #1e40af;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.1);
        padding: 5px 15px;
        border-radius: 8px;
    }

        .filter-group input {
            border: none;
            border-radius: 4px;
            padding: 2px 8px;
            font-weight: bold;
            font-size: 13px;
        }

    .filters-row input {
        width: 100%;
        padding: 4px 8px;
        font-size: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
    }

    /* التصميم الرقمي LCD المطور */
    .lcd-container {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 30px;
        margin-bottom: 50px;
    }

    .lcd-screen {
        background-color: #050505;
        border: 4px solid #1e293b;
        border-radius: 10px;
        padding: 10px 35px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    #txtTotal {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 75px;
        text-shadow: 0 0 15px rgba(0, 255, 65, 0.8);
        letter-spacing: 2px;
    }

    .lcd-currency {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 32px;
        margin-left: 15px;
        border: 1px solid rgba(0,255,65,0.3);
        padding: 0 8px;
    }
</style>

<div class="container-fluid p-4">
    <div class="page-header d-flex justify-content-between align-items-center shadow">
        <h4 class="mb-0 fw-bold"><i class="fas fa-calendar-check me-2"></i> RECAP ACHATS PAR MOIS</h4>

        <div class="d-flex align-items-center">
            <div class="filter-group me-3">
                <label class="small text-white-50"><i class="fas fa-calendar-alt me-1"></i> MOIS:</label>
                <select id="monthSelect" class="form-select form-select-sm border-0 fw-bold" style="width: 150px; cursor: pointer;">
                    <option value="">Tous les mois</option>
                    <option value="01">Janvier</option>
                    <option value="02">Février</option>
                    <option value="03">Mars</option>
                    <option value="04">Avril</option>
                    <option value="05">Mai</option>
                    <option value="06">Juin</option>
                    <option value="07">Juillet</option>
                    <option value="08">Août</option>
                    <option value="09">Septembre</option>
                    <option value="10">Octobre</option>
                    <option value="11">Novembre</option>
                    <option value="12">Décembre</option>
                </select>
            </div>
            <button id="btnExcel" class="btn btn-success btn-sm fw-bold px-3 me-2"><i class="fas fa-file-excel me-1"></i> EXCEL</button>
            <button class="btn btn-light btn-sm fw-bold text-primary px-3" onclick="window.print()"><i class="fas fa-print me-1"></i> IMPRIMER</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table id="recapTable" class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>FAMILLE</th>
                    <th>DATE (Fin de Mois)</th>
                    <th class="text-end">MONTANT TOTAL MENSUEL HT</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="lcd-container">
        <span class="fw-bold text-muted" style="font-size: 20px;">TOTAL GÉNÉRAL HT</span>
        <div class="lcd-screen shadow-lg">
            <span id="txtTotal">0,00</span>
            <span class="lcd-currency">DA</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <!-- ... باقي المكتبات (Excel/Print) ... -->
    <!-- 2. مكتبة JSZip (ضرورية جداً للإكسل) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <!-- 3. مكتبات أزرار DataTable -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
              $(document).ready(function () {
            // 1. تعريف دالة الفلترة
            $.fn.dataTable.ext.search = []; // مسح الفلاتر القديمة
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var selectedMonth = $('#monthSelect').val(); // ستكون قيمتها مثل "01", "02"...
                if (selectedMonth === "") return true; // إذا لم يختر شيئاً اظهر الكل

                // تاريخ الجدول في العمود الثاني (data[1]) بصيغة "dd/mm/yyyy"
                var rowDateStr = data[1];
                if (!rowDateStr || rowDateStr === "-") return false;

                // استخراج رقم الشهر من "dd/mm/yyyy" (الجزء الأوسط)
                var rowMonth = rowDateStr.split('/')[1];

                return rowMonth === selectedMonth;
            });

            // 2. تهيئة الجدول
            const table = $('#recapTable').DataTable({
                ajax: { url: "?handler=LoadData", dataSrc: "" },
                paging: false,
                dom: 'Brt',
                orderCellsTop: true,
                 buttons: [
                    {
                        extend: 'excelHtml5',
                        className: 'd-none', // إخفاء الزر الافتراضي لأننا نستخدم زرنا الملون
                        title: function() {
                            var monthName = $('#monthSelect option:selected').text();
                            return 'Recap_Achats_' + monthName  ;
                        },
                        exportOptions: {
                            columns: [0, 1, 2],
                            format: {
                                body: function (data, row, column, node) {
                                    // تنظيف الأرقام من الفراغات (مثل 1 000,00 تصبح 1000.00) ليفهمها الإكسل كرقم
                                    return column === 2 ? data.replace(/[^\d.,-]/g, '').replace(',', '.') : data;
                                }
                            }
                        }
                    }
                ],
                // buttons: [{ extend: 'excelHtml5', className: 'd-none', exportOptions: { columns: ':visible' } }],
                columns: [
                    { data: "famille", className: "fw-bold" },
                    {
                        data: "date_achat",
                        render: function(d) {
                            if(!d) return '-';
                            var date = new Date(d);
                            // نضمن ظهور التاريخ بصيغة يوم/شهر/سنة مع الأصفار
                            return ("0" + date.getDate()).slice(-2) + "/" +
                                   ("0" + (date.getMonth() + 1)).slice(-2) + "/" +
                                   date.getFullYear();
                        }
                    },
                    {
                        data: "montant", className: "text-end fw-bold text-dark",
                        render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    }
                ],
                drawCallback: function() {
                    // تحديث الإجمالي في شاشة الـ LCD
                    let total = 0;
                    this.api().rows({ search: 'applied' }).data().each(d => total += d.montant);
                    $('#txtTotal').text(total.toLocaleString('fr-FR', {minimumFractionDigits:2}));
                }
            });

            // 3. تحديث الجدول فور تغيير الاختيار من القائمة
            $('#monthSelect').on('change', function () {
                table.draw();
            });

            // أزرار الإكسل والطباعة
             // --- تشغيل التصدير عند الضغط على زر Excel الأخضر ---
            $('#btnExcel').on('click', function() {
                // التحقق من وجود بيانات مفلترة
                if (table.rows({ filter: 'applied' }).count() > 0) {
                    table.button('.buttons-excel').trigger();
                } else {
                    alert("Aucune donnée à exporter.");
                }
            });
            //$('#btnExcel').on('click', () => table.button('.buttons-excel').trigger());
        });
    </script>
}
