@page
@model PcStock_Web.Pages.Achats.ResteModel
@{
    ViewData["Title"] = "Reste en Stock des Achats";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .page-header {
        background: #1e40af;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .filters-row input {
        width: 100%;
        padding: 4px 8px;
        font-size: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
    }

    /* الشاشة الرقمية LCD */
    .lcd-container {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 25px;
    }

    .lcd-screen {
        background-color: #050505;
        border: 4px solid #1e293b;
        border-radius: 10px;
        padding: 8px 30px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    #txtTotal {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 60px;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.8);
    }

    .lcd-currency {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 25px;
        margin-left: 15px;
        border: 1px solid rgba(0,255,65,0.3);
        padding: 0 5px;
    }

    table.dataTable thead th {
        background: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 13px;
    }
</style>

<div class="container-fluid p-4">
    <div class="page-header d-flex justify-content-between align-items-center shadow">
        <h4 class="mb-0 fw-bold text-uppercase"><i class="fas fa-warehouse me-2"></i> Reste en Stock des Achats</h4>
        <div class="d-flex gap-2">
            <button id="btnExcel" class="btn btn-success btn-sm fw-bold px-3"><i class="fas fa-file-excel me-1"></i> EXCEL</button>
            <button class="btn btn-light btn-sm fw-bold text-primary px-3" onclick="window.print()"><i class="fas fa-print me-1"></i> IMPRIMER</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table id="resteTable" class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>REF</th>
                    <th>INTITULE</th>
                    <th>INTITULE 2</th>
                    <th>FAMILLE</th>
                    <th class="text-center">QTE ACHAT</th>
                    <th class="text-center">QTE STOCK</th>
                    <th class="text-end">PAMP</th>
                    <th class="text-end">MONTANT</th>
                    <th>DERNIER BEM</th>
                    <th>DATE ACHAT</th>
                    <th>FOURNISSEUR</th>
                    <th>CASIER</th> <!-- الحقل الجديد في الأخير -->
                </tr>
            </thead>
        </table>
    </div>

    <div class="lcd-container">
        <span class="fw-bold text-muted">VALEUR TOTALE DU RESTE HT</span>
        <div class="lcd-screen shadow-lg">
            <span id="txtTotal">0,00</span>
            <span class="lcd-currency">DA</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. إضافة الفلاتر
            $('#resteTable thead tr').clone(true).addClass('filters-row').appendTo('#resteTable thead');

            const table = $('#resteTable').DataTable({
                ajax: { url: "?handler=LoadData", dataSrc: "" },
                paging: false,
                scrollY: "450px",
                scrollCollapse: true,
                dom: 'Brt',
                orderCellsTop: true,
                buttons: [{ extend: 'excelHtml5', className: 'd-none', exportOptions: { columns: ':visible' } }],
                columns: [
                    { data: "ref_art", className: "fw-bold" },
                    { data: "intitule" },
                    { data: "intitule2", defaultContent: "" },
                    { data: "famille" },
                    {
                         // حقل إجمالي المشتريات
                         data: "qte_achat",
                         className: "text-center fw-bold text-primary",
                         render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    },
                    // {
                    //     data: "qte", className: "text-center fw-bold text-success",
                    //     render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    // },
                    {
                       // حقل المخزون الحالي
                       data: "qte_stock",
                       className: "text-center fw-bold text-success",
                       render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    },
                    { data: "pamp", className: "text-end", render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2}) },
                    {
                        data: "montant", className: "text-end fw-bold text-primary",
                        render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    },
                    { data: "no_br", className: "text-center fw-bold" },
                    {
                        data: "date_achat",
                        render: (d) => d ? new Date(d).toLocaleDateString('fr-FR') : '-'
                    },
                    { data: "cod_soc" },
                    { data: "casier", defaultContent: "", className: "fw-bold text-warning" } // العمود الجديد
                ],
                initComplete: function () {
                    this.api().columns().every(function (i) {
                        var column = this;
                        $('.filters-row th').eq(i).html('<input type="text" placeholder="Filtrer..." />');
                        $('input', $('.filters-row th').eq(i)).on('keyup change', function () {
                            if (column.search() !== this.value) column.search(this.value).draw();
                        });
                    });
                },
                drawCallback: function() {
                    let total = 0;
                    this.api().rows({ search: 'applied' }).data().each(d => total += d.montant);
                    $('#txtTotal').text(total.toLocaleString('fr-FR', {minimumFractionDigits:2}));
                }
            });

            $('#btnExcel').on('click', () => table.button('.buttons-excel').trigger());
        });
    </script>
}