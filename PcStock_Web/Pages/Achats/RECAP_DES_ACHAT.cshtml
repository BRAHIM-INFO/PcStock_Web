@page
@model PcStock_Web.Pages.Achats.RECAP_DES_ACHATSModel
@{
    ViewData["Title"] = "Récapitulatif des Achats";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .page-header {
        background: #1e40af;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.1);
        padding: 5px 15px;
        border-radius: 8px;
    }

        .filter-group input {
            border: none;
            border-radius: 4px;
            padding: 2px 8px;
            font-weight: bold;
            font-size: 13px;
        }

    /* تصميم الهيدر فيلتر */
    .filters-row input {
        width: 100%;
        padding: 4px 8px;
        font-size: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        font-weight: normal;
    }

    /* الشاشة الرقمية LCD */
    .lcd-container {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 30px;
        margin-bottom: 50px;
    }

    .lcd-screen {
        background-color: #050505;
        border: 4px solid #1e293b;
        border-radius: 10px;
        padding: 10px 35px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    #txtTotal {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 70px;
        text-shadow: 0 0 15px rgba(0, 255, 65, 0.8);
        letter-spacing: 2px;
    }

    .lcd-currency {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 30px;
        margin-left: 15px;
        border: 1px solid rgba(0,255,65,0.3);
        padding: 0 5px;
    }

    .card-table {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    @@media print {
        .sidebar, .page-header, .filters-row {
            display: none !important;
        }

        .lcd-container {
            margin-top: 10px;
        }
    }
</style>

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center shadow">
        <h4 class="mb-0 fw-bold"><i class="fas fa-chart-pie me-2"></i> RECAP DES ACHATS MENSUEL</h4>

        <div class="d-flex align-items-center">
            <div class="filter-group me-3">
                <label class="small text-white-50">DU:</label>
                <input type="date" id="minDate">
                <label class="small text-white-50">AU:</label>
                <input type="date" id="maxDate">
            </div>
            <button id="btnExcel" class="btn btn-success btn-sm fw-bold px-3 me-2"><i class="fas fa-file-excel me-1"></i> EXCEL</button>
            <button class="btn btn-light btn-sm fw-bold text-primary px-3" onclick="window.print()"><i class="fas fa-print me-1"></i> IMPRIMER</button>
        </div>
    </div>

    <!-- Table -->
    <div class="card card-table border-0 shadow-sm">
        <table id="recapTable" class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>FAMILLE</th>
                    <th>DATE (FIN DE MOIS)</th>
                    <th class="text-end">MONTANT TOTAL HT</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- LCD Display -->
    <div class="lcd-container">
        <span class="fw-bold text-muted" style="font-size: 20px;">TOTAL</span>
        <div class="lcd-screen shadow-lg">
            <span id="txtTotal">0,00</span>
            <span class="lcd-currency">DA</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. منطق فلترة التاريخ
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var min = $('#minDate').val();
                var max = $('#maxDate').val();
                if (!min && !max) return true;

                var rowDate = new Date(data[1]); // تاريخ العمود الثاني (YYYY-MM-DD)
                var start = min ? new Date(min) : null;
                var end = max ? new Date(max) : null;

                if (start) start.setHours(0,0,0,0);
                if (end) end.setHours(23,59,59,999);

                return (!start || rowDate >= start) && (!end || rowDate <= end);
            });

            // 2. إضافة صف الفلاتر
            $('#recapTable thead tr').clone(true).addClass('filters-row').appendTo('#recapTable thead');

            const table = $('#recapTable').DataTable({
                ajax: { url: "?handler=LoadData", dataSrc: "" },
                paging: false,
                dom: 'Brt',
                orderCellsTop: true,
                buttons: [{ extend: 'excelHtml5', className: 'd-none', exportOptions: { columns: ':visible' } }],
                columns: [
                    { data: "famille", className: "fw-bold" },
                    {
                        data: "date",
                        render: (d) => d ? new Date(d).toLocaleDateString('fr-FR') : '-'
                    },
                    {
                        data: "montant", className: "text-end fw-bold text-dark",
                        render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    }
                ],
                initComplete: function () {
                    this.api().columns().every(function (i) {
                        var column = this;
                        $('.filters-row th').eq(i).html('<input type="text" placeholder="Filtrer..." />');
                        $('input', $('.filters-row th').eq(i)).on('keyup change', function () {
                            if (column.search() !== this.value) column.search(this.value).draw();
                        });
                    });
                },
                drawCallback: function() {
                    let total = 0;
                    this.api().rows({ search: 'applied' }).data().each(d => total += d.montant);
                    $('#txtTotal').text(total.toLocaleString('fr-FR', {minimumFractionDigits:2}));
                }
            });

            $('#minDate, #maxDate').on('change', () => table.draw());
            $('#btnExcel').on('click', () => table.button('.buttons-excel').trigger());
        });
    </script>
}