@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <!-- CSS الخاص بالـ Scroller -->
    <link rel="stylesheet" href="https://cdn.datatables.net/scroller/2.2.0/css/scroller.dataTables.min.css"> 
    <!-- JS الخاص بالـ Scroller -->
    <script src="https://cdn.datatables.net/scroller/2.2.0/js/dataTables.scroller.min.js"></script>
    <script>
        $(document).ready(function () {
            // 1. إضافة صف الفلترة
            $('#mainTable thead tr').clone(true).addClass('filters-row').appendTo('#mainTable thead');
                 // 1. تعريف وظيفة البحث المخصصة للتواريخ في DataTables
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var min = $('#minDate').val();
                var max = $('#maxDate').val();
            
                // جلب التاريخ من العمود رقم 2 (DATE) وتنسيقه للمقارنة
                // ملاحظة: البيانات في الجدول تكون بصيغة dd/mm/yyyy، نحولها لـ Date object
                var dateParts = data[2].split('/');
                var rowDate = new Date(dateParts[2], dateParts[1] - 1, dateParts[0]);
            
                var startDate = min ? new Date(min) : null;
                var endDate = max ? new Date(max) : null;
            
                if (startDate) startDate.setHours(0,0,0,0);
                if (endDate) endDate.setHours(23,59,59,999);
            
                if (
                    (!startDate && !endDate) ||
                    (!startDate && rowDate <= endDate) ||
                    (startDate <= rowDate && !endDate) ||
                    (startDate <= rowDate && rowDate <= endDate)
                ) {
                    return true;
                }
                return false;
            });
            const table = $('#mainTable').DataTable({
                ajax: { url: "?handler=LoadData", dataSrc: "" },
                deferRender: true,
                scrollY: 500,
                scrollCollapse: false,
                scroller: true,
                orderCellsTop: true,
                dom: 'rt',
                buttons: [{ extend: 'excelHtml5', className: 'd-none', exportOptions: { columns: ':visible' } }],
                columns: [
                    { data: "famille", className: "fw-bold" },
                    { data: "no_br", className: "text-primary fw-bold" },
                    {
                        data: "date_achat",
                        render: (d) => d ? new Date(d).toLocaleDateString('fr-FR') : '-'
                    },
                    { data: "no_faca" },
                    { data: "fournisseur" },
                    {
                        data: "montant", className: "text-end fw-bold",
                        render: (d) => parseFloat(d).toLocaleString('fr-FR', {minimumFractionDigits:2})
                    }
                ],
                initComplete: function () {
                    var api = this.api();
                    api.columns().every(function (i) {
                        var column = this;
                        var headerCell = $('.filters-row th').eq(i);
                        headerCell.html('<input type="text" placeholder="Filtrer..." />');
                        $('input', headerCell).on('keyup change', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                },
                drawCallback: function() {
                    let total = 0;
                    this.api().rows({ search: 'applied' }).data().each(d => total += d.montant);
                    $('#txtTotal').text(total.toLocaleString('fr-FR', {minimumFractionDigits:2}));
                }
            });
                 // 3. إعادة رسم الجدول عند تغيير التواريخ
            $('#minDate, #maxDate').on('change', function () {
                table.draw();
            });
            $('#btnExport').on('click', () => table.button('.buttons-excel').trigger());
            $('#btnPrint').on('click', () => window.print());
        });
    </script>
}