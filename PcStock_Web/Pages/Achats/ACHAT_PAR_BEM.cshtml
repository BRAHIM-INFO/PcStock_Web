@page
@model PcStock_Web.Pages.Achats.ACHAT_PAR_BEMModel
@{
    ViewData["Title"] = "Achats par BEM & Famille";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">
<link href="https://fonts.cdnfonts.com/css/digital-7-mono" rel="stylesheet">

<style>
    .page-header {
        background: #1e40af;
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .filters-row input {
        width: 100%;
        padding: 4px 8px;
        font-size: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
    }

    .total-wrapper {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 20px;
    }

    .total-display {
        background: #050505;
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 50px;
        padding: 5px 25px;
        border-radius: 8px;
        border: 3px solid #334155;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
        min-width: 300px;
        text-align: right;
    }

    /* تحسين شكل الجدول */
    .dataTables_scrollBody {
        background: white !important;
        border-radius: 0 0 12px 12px;
    }

    thead tr.filters-row th {
        background: #f8fafc !important;
        padding: 5px !important;
    }
    /* إجبار الجدول على إظهار شريط التمرير */
    .dataTables_scrollBody {
        min-height: 400px;
        max-height: 500px; /* يمكنك زيادة هذا الرقم حسب حجم الشاشة */
        overflow-y: scroll !important;
        background: white !important;
    }

        /* تجميل شريط التمرير ليظهر بشكل عصري */
        .dataTables_scrollBody::-webkit-scrollbar {
            width: 8px;
        }

        .dataTables_scrollBody::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            .dataTables_scrollBody::-webkit-scrollbar-thumb:hover {
                background: #1e40af;
            }

    /* تثبيت الهيدر ومنع اختفائه */
    .dataTables_scrollHead {
        background: #f8fafc !important;
        border-bottom: 2px solid #e2e8f0 !important;
    }
    /* حاوية الفلترة في الأعلى */
    .filter-group {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.1);
        padding: 5px 15px;
        border-radius: 8px;
        margin-right: 10px;
    }

        .filter-group label {
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 0;
        }

        .filter-group input {
            border: none;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 13px;
            font-weight: bold;
        }

    /* تصميم الشاشة الرقمية المطابق للصورة */
    .lcd-display-container {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 30px;
    }

    .lcd-screen {
        background-color: #050505;
        border: 4px solid #1e293b;
        border-radius: 10px;
        padding: 10px 30px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3), inset 0 0 15px #000;
    }

    #txtTotal {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 65px;
        font-weight: normal;
        text-shadow: 0 0 12px rgba(0, 255, 65, 0.9);
        letter-spacing: 2px;
    }

    .lcd-currency {
        color: #00ff41;
        font-family: 'Digital-7 Mono', sans-serif;
        font-size: 28px;
        margin-left: 15px;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.7);
        border: 1px solid rgba(0, 255, 65, 0.3);
        padding: 2px 5px;
        line-height: 1;
    }
</style>

<div class="container-fluid p-4">
    <!-- الهيدر مع فلترة التاريخ -->
    <div class="page-header d-flex justify-content-between align-items-center shadow">
        <h4 class="mb-0 fw-bold"><i class="fas fa-layer-group me-2"></i> ACHATS PAR BEM</h4>

        <div class="d-flex align-items-center">
            <!-- فلاتر التاريخ -->
            <div class="filter-group me-3">
                <div class="d-flex align-items-center me-2">
                    <label class="me-2 text-white-50">Du:</label>
                    <input type="date" id="minDate" class="form-control form-control-sm">
                </div>
                <div class="d-flex align-items-center">
                    <label class="me-2 text-white-50">Au:</label>
                    <input type="date" id="maxDate" class="form-control form-control-sm">
                </div>
            </div>

            <div class="d-flex gap-2">
                <button id="btnExport" class="btn btn-success btn-sm fw-bold px-3"><i class="fas fa-file-excel me-1"></i> EXCEL</button>
                <button id="btnPrint" class="btn btn-light btn-sm fw-bold text-primary px-3"><i class="fas fa-print me-1"></i> IMPRIMER</button>
            </div>
        </div>
    </div>

    <!-- الجدول -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table id="mainTable" class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>FAMILLE</th>
                    <th>BEM N°</th>
                    <th>DATE</th>
                    <th>FACTURE N°</th>
                    <th>FOURNISSEUR</th>
                    <th class="text-end">MONTANT TOTAL HT</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- الإجمالي الرقمي المطور -->
    <div class="lcd-display-container">
        <span class="total-label fw-bold text-muted">TOTAL GÉNÉRAL HT</span>
        <div class="lcd-screen shadow-lg">
            <span id="txtTotal">0,00</span>
            <span class="lcd-currency">DA</span>
        </div>
    </div>
</div>

