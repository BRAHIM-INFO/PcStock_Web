<body>

    <div class="no-print-zone shadow">
        <form method="get">
            <div class="mb-2">
                <label class="small fw-bold">Du:</label>
                <input type="date" name="DateDeb" value="@Model.DateDeb?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
            </div>
            <div class="mb-3">
                <label class="small fw-bold">Au:</label>
                <input type="date" name="DateFin" value="@Model.DateFin?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
            </div>
            <button type="submit" class="btn btn-primary btn-sm w-100 mb-2">Actualiser</button>
            <button type="button" class="btn btn-dark btn-sm w-100" onclick="window.print()">Imprimer Rapport</button>
        </form>
    </div>

    <div class="report-page">
        <!-- 1. الهيدر الرسمي المحدث -->
        <header class="official-header">
            <div class="header-info">
                <h5>كوسيدار أشغال عمومية شركة بالأسهم</h5>
                <p>رأس المال الإجتماعي : 4.000.000.000,00 دج - س ت رقم 99 ب 0009368 - 16/00</p>
                <p>المقر الإجتماعي : حي كليمون - المحمدية - الجزائر</p>
                <div class="mt-1" style="border-top: 1px solid #eee; padding-top: 5px;">
                    <p><b>COSIDER Travaux Publics, Société par Actions</b></p>
                    <p>Capital Social: 4.000.000.000,00 DA - R.C 99 B 0009368 - 00/16</p>
                    <p>Siège social : Cité Clément - Mohammadia - Alger</p>
                </div>
            </div>
            <div class="header-logo">
                <img src="~/images/logo_entreprise.png" alt="COSIDER LOGO">
            </div>
        </header>

        <div class="text-center mb-4">
            <h4 class="fw-bold text-uppercase border-bottom d-inline-block pb-1">Bilan Global de Gestion des Stocks</h4>
            <p class="small text-muted">Période du @Model.DateDeb?.ToString("dd/MM/yyyy") au @Model.DateFin?.ToString("dd/MM/yyyy")</p>
        </div>

        <!-- 2. المربعات الملونة مع الأيقونات (مطابق تماماً للصورة) -->
        <div class="stat-grid">
            <!-- Row 1 -->
            <div class="stat-card card-blue">
                <span class="label"><i class="fas fa-warehouse"></i> Stock Actuel (Valeur)</span>
                <div class="value">@Model.Stats.StockActuel.ToString("N2")</div>
            </div>
            <div class="stat-card card-black">
                <span class="label"><i class="fas fa-shopping-cart"></i> Total Achats (Période)</span>
                <div class="value">@Model.Stats.Achats.ToString("N2")</div>
            </div>
            <div class="stat-card card-red">
                <span class="label"><i class="fas fa-file-export"></i> Cessions Fournies</span>
                <div class="value">@Model.Stats.CessionF.ToString("N2")</div>
            </div>
            <div class="stat-card card-gold">
                <span class="label"><i class="fas fa-gas-pump"></i> Consommations</span>
                <div class="value">@Model.Stats.Consos.ToString("N2")</div>
            </div>

            <!-- Row 2 -->
            <div class="stat-card card-green">
                <span class="label"><i class="fas fa-undo"></i> Réintégrations</span>
