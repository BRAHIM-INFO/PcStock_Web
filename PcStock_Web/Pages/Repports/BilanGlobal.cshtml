@page
@model PcStock_Web.Pages.Repports.BilanGlobalModel
@{
    Layout = null; // مستقل تماماً للطباعة
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Bilan Global Analytique - COSIDER TP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --cosider-red: #ed1c24;
            --cosider-blue: #1e40af;
            --bg-report: #ffffff;
        }

        body {
            background-color: #525659;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            margin: 0;
        }

        /* إعدادات الورقة A4 */
        .report-page {
            width: 210mm;
            min-height: 297mm;
            padding: 10mm 15mm;
            margin: 10px auto;
            background: white;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
        }

        /* --- الهيدر الرسمي --- */
        .official-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid var(--cosider-red);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .header-info {
            text-align: center;
            flex-grow: 1;
        }

            .header-info h5 {
                font-size: 15px;
                font-weight: bold;
                margin: 0;
            }

            .header-info p {
                font-size: 10px;
                margin: 0;
                font-weight: 600;
                color: #1e293b;
            }

        .header-logo img {
            width: 220px;
        }

        .report-title {
            text-align: center;
            margin-bottom: 20px;
        }

            .report-title h2 {
                font-weight: 900;
                text-decoration: underline;
                text-underline-offset: 8px;
                font-size: 24px;
            }

        /* --- البطاقات الملونة (8 مربعات) --- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 5px;
            text-align: center;
        }

            .stat-card .label {
                font-size: 9px;
                font-weight: 800;
                color: #64748b;
                text-transform: uppercase;
                margin-bottom: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
            }

            .stat-card .value {
                font-size: 17px;
                font-weight: 850;
            }

        .card-blue {
            border-color: #2563eb !important;
            background: #f0f7ff;
        }

            .card-blue .value {
                color: #2563eb;
            }

        .card-red {
            border-color: #ef4444 !important;
        }

            .card-red .value {
                color: #ef4444;
            }

        .card-gold {
            border-color: #eab308 !important;
        }

            .card-gold .value {
                color: #eab308;
            }

        .card-green {
            border-color: #10b981 !important;
        }

            .card-green .value {
                color: #10b981;
            }

        /* --- الجداول --- */
        .table-box {
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            padding: 12px;
            background: #fff;
            height: 100%;
        }

        .table-title {
            font-size: 11px;
            font-weight: 800;
            color: var(--cosider-blue);
            margin-bottom: 8px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .report-table {
            font-size: 10px;
            margin-bottom: 0;
        }

            .report-table thead th {
                background: #f1f5f9;
            }

        /* --- الرسوم البيانية (الجزء السفلي الجديد) --- */
        .charts-row {
            margin-top: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .chart-box {
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            background: #fff;
        }

        .chart-container {
            height: 200px;
            position: relative;
        }

        /* زر الطباعة */
        .no-print-zone {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1000;
            background: white;
            padding: 15px;
            border-radius: 10px;
        }

        @@media print {
            body {
                background: white;
            }

            .report-page {
                margin: 0;
                box-shadow: none;
                width: 100%;
            }

            .no-print-zone {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- تحكم الفلترة -->
    <div class="no-print-zone shadow">
        <form method="get">
            <input type="date" name="DateDeb" value="@Model.DateDeb?.ToString("yyyy-MM-dd")" class="form-control form-control-sm mb-2">
            <input type="date" name="DateFin" value="@Model.DateFin?.ToString("yyyy-MM-dd")" class="form-control form-control-sm mb-2">
            <button type="submit" class="btn btn-primary btn-sm w-100 mb-2">Filtrer</button>
            <button type="button" class="btn btn-dark btn-sm w-100" onclick="window.print()">Imprimer</button>
        </form>
    </div>

    <div class="report-page">
        <!-- 1. الهيدر الرسمي -->
        <header class="official-header">
            <div class="header-info">
                <h5>كوسيدار أشغال عمومية شركة بالأسهم</h5>
                <p>رأس المال الإجتماعي : 4.000.000.000,00 دج - المقر الإجتماعي : حي كليمون - المحمدية - الجزائر</p>
                <div class="mt-1">
                    <p><b>COSIDER Travaux Publics, Société par Actions</b></p>
                    <p>Siège social : Cité Clément - Mohammadia - Alger</p>
                </div>
            </div>
            <div class="header-logo">
                <img src="~/images/logo_entreprise.png" alt="COSIDER LOGO">
            </div>
        </header>

        <div class="report-title">
            <h2>BILAN GLOBAL DE GESTION DES STOCKS</h2>
            <p class="small text-muted">Situation du @Model.DateDeb?.ToString("dd/MM/yyyy") au @Model.DateFin?.ToString("dd/MM/yyyy")</p>
        </div>

        <!-- 2. شبكة المربعات (8 بطاقات) -->
        <div class="stat-grid">
            <div class="stat-card card-blue">
                <span class="label"><i class="fas fa-warehouse"></i> STOCK ACTUEL (VALEUR)</span>
                <div class="value">@Model.Stats.StockActuel.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <span class="label"><i class="fas fa-shopping-cart"></i> TOTAL ACHATS (PÉRIODE)</span>
                <div class="value text-dark">@Model.Stats.Achats.ToString("N2")</div>
            </div>
            <div class="stat-card card-red">
                <span class="label"><i class="fas fa-file-export"></i> CESSIONS FOURNIES</span>
                <div class="value">@Model.Stats.CessionF.ToString("N2")</div>
            </div>
            <div class="stat-card card-gold">
                <span class="label"><i class="fas fa-gas-pump"></i> CONSOMMATIONS</span>
                <div class="value">@Model.Stats.Consos.ToString("N2")</div>
            </div>

            <div class="stat-card card-green">
                <span class="label"><i class="fas fa-undo"></i> RÉINTÉGRATIONS</span>
                <div class="value">@Model.Stats.Reinteg.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <span class="label"><i class="fas fa-boxes"></i> NB ARTICLES ACTIVE</span>
                <div class="value">@Model.Stats.NbArticles</div>
            </div>
            <div class="stat-card">
                <span class="label"><i class="fas fa-file-invoice"></i> NOMBRE FACTURES</span>
                <div class="value">@Model.Stats.NbFact</div>
            </div>
            <div class="stat-card">
                <span class="label"><i class="fas fa-file-signature"></i> NOMBRE BSM</span>
                <div class="value">@Model.Stats.NbBSM</div>
            </div>
        </div>

        <!-- 3. الجداول الرئيسية -->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <div class="table-box shadow-sm">
                    <div class="table-title"><i class="fas fa-building"></i> Top 10 Chantiers Livrés</div>
                    <table class="table table-sm report-table table-striped">
                        <thead><tr><th>Désignation Unité</th><th class="text-end">Montant HT</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.TopChantiers)
                            {
                                <tr><td>@item.Name</td><td class="text-end fw-bold">@item.Amount.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-6">
                <div class="table-box shadow-sm">
                    <div class="table-title"><i class="fas fa-truck"></i> Top 10 Fournisseurs</div>
                    <table class="table table-sm report-table table-striped">
                        <thead><tr><th>Nom Fournisseur</th><th class="text-end">Montant HT</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.TopFournisseurs)
                            {
                                <tr><td>@item.Name</td><td class="text-end fw-bold">@item.Amount.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. الرسوم البيانية (الجزء السفلي) -->
        <div class="charts-row">
            <div class="chart-box shadow-sm">
                <div class="table-title justify-content-center"><i class="fas fa-chart-pie"></i> Stock par Famille (Valeur)</div>
                <div class="chart-container">
                    <canvas id="stockPieChart"></canvas>
                </div>
            </div>
            <div class="chart-box shadow-sm">
                <div class="table-title justify-content-center"><i class="fas fa-chart-bar"></i> Achats par Famille (Montant)</div>
                <div class="chart-container">
                    <canvas id="achatBarChart"></canvas>
                </div>
            </div>
        </div>

        <div class="mt-auto pt-3 border-top d-flex justify-content-between small text-muted">
            <span>Document généré par PcStock-Web le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
            <span class="fw-bold text-dark">Visa et Signature</span>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* إضافة مكتبة لإظهار الأرقام فوق الرسوم عند الطباعة *@
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>

    <script>
        // تسجيل الإضافة لإظهار المبالغ مكتوبة
        Chart.register(ChartDataLabels);

        const sData = @Html.Raw(Model.StockChartJson);
        const aData = @Html.Raw(Model.AchatChartJson);

        // 1. Pie Chart
        new Chart(document.getElementById('stockPieChart'), {
            type: 'doughnut',
            data: {
                labels: sData.map(x => x.Name),
                datasets: [{
                    data: sData.map(x => x.Amount),
                    backgroundColor: ['#1e40af', '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#64748b']
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 8 } } },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 9 },
                        formatter: (value) => {
                            if(value < 1000000) return ""; // إخفاء القيم الصغيرة جداً لعدم الازدحام
                            return (value / 1000000).toFixed(1) + "M";
                        }
                    }
                }
            }
        });

        // 2. Bar Chart
        new Chart(document.getElementById('achatBarChart'), {
            type: 'bar',
            data: {
                labels: aData.map(x => x.Name),
                datasets: [{
                    label: 'Montant HT',
                    data: aData.map(x => x.Amount),
                    backgroundColor: '#1e40af',
                    borderRadius: 5
                }]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { font: { size: 8 } } },
                    x: { ticks: { font: { size: 9 } } }
                },
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        anchor: 'end',
                        align: 'top',
                        color: '#1e40af',
                        font: { weight: 'bold', size: 9 },
                        formatter: (value) => (value / 1000000).toFixed(1) + "M"
                    }
                }
            }
        });
    </script>
</body>
</html>
@* @page
@model PcStock_Web.Pages.Repports.BilanGlobalModel
