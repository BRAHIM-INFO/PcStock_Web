                <span class="label"><i class="fas fa-boxes"></i> NB Articles Active</span>
                <div class="value">@Model.Stats.NbArticles</div>
            </div>
            <div class="stat-card card-black">
                <span class="label"><i class="fas fa-file-invoice-dollar"></i> Nombre Factures</span>
                <div class="value">@Model.Stats.NbFact</div>
            </div>
            <div class="stat-card card-black">
                <span class="label"><i class="fas fa-file-signature"></i> Nombre BSM</span>
                <div class="value">@Model.Stats.NbBSM</div>
