                </div>
            </div>
        </div>

        <!-- 4. التوقيعات -->
        <div class="mt-5 pt-4" style="border-top: 1px solid #eee;">
            <div class="row text-center fw-bold small">
                <div class="col-4">Magasinier</div>
                <div class="col-4">Chef de Service</div>
                <div class="col-4">Le Directeur (DCM)</div>
            </div>
